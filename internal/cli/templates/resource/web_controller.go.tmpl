	if problems := request.ValidateCreate(); !problems.Empty() {
		return controller.renderForm(ctx, user.ID, http.StatusUnprocessableEntity, "pages/[[.Plural]]/new", FormPage{
			Title: "New [[.Name]]", Action: webBasePath, Submit: "Create [[.Name]]", Values: request.FormValues(), Errors: problems.Messages(),
		})
	}
	item, err := controller.repository.Create(ctx.Request.Context(), [[if .AuthorizationPolicies]]scope[[else]]user.ID[[end]], request.Attributes[[if .Relationships]], request.Associations[[end]])
[[if .Relationships]]	if field, invalid := invalidAssociationField(err); invalid {
		return controller.renderForm(ctx, user.ID, http.StatusUnprocessableEntity, "pages/[[.Plural]]/new", FormPage{
			Title: "New [[.Name]]", Action: webBasePath, Submit: "Create [[.Name]]", Values: request.FormValues(),
			Errors: validation.Errors{field: {"is not available"}},
		})
	}
[[end]]	if err != nil {
		return err
	}
	if err := flashNotice(ctx, "[[.Name]] created."); err != nil {
		return err
	}
	return web.Redirect(ctx, webItemPath(item.ID))
}

