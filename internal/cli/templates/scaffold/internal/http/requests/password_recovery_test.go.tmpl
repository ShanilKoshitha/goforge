package requests_test

import (
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/ShanilKoshitha/goforge/httpx"

	"[[.Module]]/internal/http/requests"
)

func TestForgotPasswordRequestNormalizesAndValidatesEmail(t *testing.T) {
	var decoded requests.ForgotPasswordRequest
	router := httpx.NewRouter()
	router.POST("/forgot", func(ctx *httpx.Context) error {
		if err := decoded.DecodeJSON(ctx); err != nil {
			return err
		}
		if problems := decoded.Validate(); !problems.Empty() {
			return httpx.NewHTTPError(http.StatusUnprocessableEntity, "validation failed").WithDetails(problems)
		}
		return ctx.NoContent(http.StatusNoContent)
	})

	request := httptest.NewRequest(http.MethodPost, "/forgot", strings.NewReader(`{"email":"  Ada@Example.COM  "}`))
	request.Header.Set("Content-Type", "application/json; charset=utf-8")
	response := httptest.NewRecorder()
	router.ServeHTTP(response, request)
	if response.Code != http.StatusNoContent {
		t.Fatalf("status = %d: %s", response.Code, response.Body.String())
	}
	if decoded.Email != "ada@example.com" {
		t.Fatalf("email = %q", decoded.Email)
	}
}

func TestPasswordRecoveryJSONBoundariesAreExact(t *testing.T) {
	tests := []struct {
		name        string
		contentType string
		body        string
		forgot      bool
		want        int
	}{
		{name: "wrong media", contentType: "text/plain", body: `{}`, forgot: true, want: http.StatusUnsupportedMediaType},
		{name: "malformed", contentType: "application/json", body: `{"email":`, forgot: true, want: http.StatusBadRequest},
		{name: "null root", contentType: "application/json", body: `null`, forgot: true, want: http.StatusBadRequest},
		{name: "unknown field", contentType: "application/json", body: `{"email":"a@example.com","admin":true}`, forgot: true, want: http.StatusBadRequest},
		{name: "email type", contentType: "application/json", body: `{"email":42}`, forgot: true, want: http.StatusBadRequest},
		{name: "invalid email", contentType: "application/json", body: `{"email":"not-an-address"}`, forgot: true, want: http.StatusUnprocessableEntity},
		{name: "reset type", contentType: "application/json", body: `{"token":42}`, want: http.StatusBadRequest},
		{name: "reset semantic", contentType: "application/json", body: `{"token":"x","password":"short","password_confirmation":"different"}`, want: http.StatusUnprocessableEntity},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			router := httpx.NewRouter()
			router.POST("/request", func(ctx *httpx.Context) error {
				if test.forgot {
					var request requests.ForgotPasswordRequest
					if err := request.DecodeJSON(ctx); err != nil {
						return err
					}
					if problems := request.Validate(); !problems.Empty() {
						return httpx.NewHTTPError(http.StatusUnprocessableEntity, "validation failed").WithDetails(problems)
					}
				} else {
					var request requests.ResetPasswordRequest
					if err := request.DecodeJSON(ctx); err != nil {
						return err
					}
					if problems := request.Validate(); !problems.Empty() {
						return httpx.NewHTTPError(http.StatusUnprocessableEntity, "validation failed").WithDetails(problems)
					}
				}
				return ctx.NoContent(http.StatusNoContent)
			})
			request := httptest.NewRequest(http.MethodPost, "/request", strings.NewReader(test.body))
			request.Header.Set("Content-Type", test.contentType)
			response := httptest.NewRecorder()
			router.ServeHTTP(response, request)
			if response.Code != test.want {
				t.Fatalf("status = %d, want %d: %s", response.Code, test.want, response.Body.String())
			}
			if strings.Contains(response.Body.String(), "unexpected EOF") || strings.Contains(response.Body.String(), "unknown field") {
				t.Fatalf("decoder detail reached client: %s", response.Body.String())
			}
		})
	}
}

func TestResetPasswordRequestPreservesSecretsAndConfirmsPassword(t *testing.T) {
	const token = "Selector.Secret_With-URL-safe-punctuation"
	const password = "  a replacement passphrase  "
	var decoded requests.ResetPasswordRequest
	router := httpx.NewRouter()
	router.POST("/reset", func(ctx *httpx.Context) error {
		if err := decoded.DecodeForm(ctx); err != nil {
			return err
		}
		if problems := decoded.Validate(); !problems.Empty() {
			return httpx.NewHTTPError(http.StatusUnprocessableEntity, "validation failed").WithDetails(problems)
		}
		return ctx.NoContent(http.StatusNoContent)
	})
	body := "token=" + token + "&password=++a+replacement+passphrase++&password_confirmation=++a+replacement+passphrase++"
	request := httptest.NewRequest(http.MethodPost, "/reset", strings.NewReader(body))
	request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	response := httptest.NewRecorder()
	router.ServeHTTP(response, request)
	if response.Code != http.StatusNoContent {
		t.Fatalf("status = %d: %s", response.Code, response.Body.String())
	}
	if decoded.Token != token || decoded.Password != password || decoded.PasswordConfirmation != password {
		t.Fatalf("secret fields were changed: token=%q password=%q confirmation=%q", decoded.Token, decoded.Password, decoded.PasswordConfirmation)
	}
}

func TestPasswordRecoveryFormRejectsRepeatedScalars(t *testing.T) {
	router := httpx.NewRouter()
	router.POST("/forgot", func(ctx *httpx.Context) error {
		var request requests.ForgotPasswordRequest
		return request.DecodeForm(ctx)
	})
	request := httptest.NewRequest(http.MethodPost, "/forgot", strings.NewReader("email=ada%40example.com&email=grace%40example.com"))
	request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	response := httptest.NewRecorder()
	router.ServeHTTP(response, request)
	if response.Code != http.StatusBadRequest {
		t.Fatalf("status = %d: %s", response.Code, response.Body.String())
	}
}
