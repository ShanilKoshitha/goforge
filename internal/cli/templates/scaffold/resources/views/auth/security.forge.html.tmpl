@extends("layouts/app")
@section("title"){{.Title}}@endsection
@section("content")
    @component("components/card", title=.Title)
      <p>Signed in as {{.User.Email}}</p>
      @if(.Notice)<p role="status">{{.Notice}}</p>@endif
      @if(.CreatedToken)
      <section aria-labelledby="created-token-heading">
        <h2 id="created-token-heading">New personal access token</h2>
        <p>Copy this token now. It will not be shown again.</p>
        <output aria-label="New personal access token"><code>{{.CreatedToken}}</code></output>
      </section>
      @endif
      <section aria-labelledby="personal-tokens-heading">
        <h2 id="personal-tokens-heading">Personal access tokens</h2>
        <form action="/settings/tokens" method="post">
          @csrf(form=.TokenForm)
          @component("components/input", form=.TokenForm, id="token-name", name="name", label="Name", recover=true, attributes(maxlength=80, required=true))@endcomponent
          @component("components/input", form=.TokenForm, id="token-expires-in-days", name="expires_in_days", label="Expires in days", recover=true, type="number", attributes(min=1, max=90, required=true))@endcomponent
          @component("components/input", form=.TokenForm, id="token-current-password", name="current_password", label="Current password", recover=false, type="password", attributes(autocomplete="current-password", required=true))@endcomponent
          <button type="submit">Create token</button>
        </form>
        @if(.Tokens)
        <ul>
          @for(.Tokens)<li>
            <strong>{{.Name}}</strong>
            <span>Expires <time datetime="{{.ExpiresAt.Format "2006-01-02T15:04:05Z07:00"}}">{{.ExpiresAt.Format "2006-01-02"}}</time></span>
            <form action="/settings/tokens/{{.ID}}/revoke" method="post">
              @csrf(form=$.ActionForm)
              <button type="submit">Revoke {{.Name}}</button>
            </form>
          </li>@endfor
        </ul>
        @else
        <p>No active personal access tokens.</p>
        @endif
      </section>
      <section aria-labelledby="password-heading">
      <h2 id="password-heading">Change password</h2>
      <form action="/settings/password" method="post">
        @csrf(form=.PasswordForm)
        @component("components/input", form=.PasswordForm, id="security-current-password", name="current_password", label="Current password", recover=false, type="password", attributes(autocomplete="current-password", required=true))@endcomponent
        @component("components/input", form=.PasswordForm, id="security-new-password", name="password", label="New password", recover=false, type="password", attributes(autocomplete="new-password", required=true))@endcomponent
        @component("components/input", form=.PasswordForm, id="security-password-confirmation", name="password_confirmation", label="Confirm new password", recover=false, type="password", attributes(autocomplete="new-password", required=true))@endcomponent
        <button type="submit">Change password</button>
      </form>
      </section>
      <form action="/settings/logout-all" method="post">
        @csrf(form=.ActionForm)
        <button type="submit">Sign out everywhere</button>
      </form>
      @slot("actions")<a href="/app">Back to dashboard</a>@endslot
    @endcomponent
@endsection
