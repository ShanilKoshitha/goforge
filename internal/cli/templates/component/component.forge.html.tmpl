@props(title, tone="neutral")
[[if .Attributes]]<article @attributes(class="card", class=(printf "card--%s" $tone))>[[else]]<article class="card card--{{$tone}}">[[end]]
  <header><h2>{{$title}}</h2></header>
  <div>@slot("default")@endslot</div>
  <footer>@slot("actions")@endslot</footer>
</article>
