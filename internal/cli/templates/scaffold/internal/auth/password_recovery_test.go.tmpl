package auth

import (
	"context"
	"errors"
	"strings"
	"testing"
	"time"
)

func TestPasswordRecoveryWorkFinishesBeforePublicResponseFloor(t *testing.T) {
	if passwordRecoveryWorkTimeout >= passwordRecoveryMinimumResponse {
		t.Fatalf("work timeout %s must remain below response floor %s", passwordRecoveryWorkTimeout, passwordRecoveryMinimumResponse)
	}
	if passwordRecoveryMaximumJitter <= 0 {
		t.Fatalf("response jitter = %s", passwordRecoveryMaximumJitter)
	}
}

func TestPasswordRecoveryResponseDurationStaysInsidePublicEnvelope(t *testing.T) {
	maximum := passwordRecoveryMinimumResponse + passwordRecoveryMaximumJitter
	seenMinimum, seenMaximum := false, false
	for sample := 0; sample <= int(^uint16(0)); sample++ {
		duration := passwordRecoveryResponseDuration(uint16(sample))
		if duration < passwordRecoveryMinimumResponse || duration > maximum {
			t.Fatalf("sample %d produced response duration %s outside [%s, %s]", sample, duration, passwordRecoveryMinimumResponse, maximum)
		}
		seenMinimum = seenMinimum || duration == passwordRecoveryMinimumResponse
		seenMaximum = seenMaximum || duration == maximum
	}
	if !seenMinimum || !seenMaximum {
		t.Fatalf("response duration mapping did not cover both envelope bounds: minimum=%t maximum=%t", seenMinimum, seenMaximum)
	}
}

func TestPasswordRecoveryPublicResponseWrapsWorkInOnePreselectedDeadline(t *testing.T) {
	selected := time.Unix(1_700_000_000, 123)
	events := make([]string, 0, 3)
	waits := 0
	recovery := &PasswordRecovery{
		selectDeadline: func(time.Time) time.Time {
			events = append(events, "select")
			return selected
		},
		waitForResponse: func(_ context.Context, deadline time.Time) error {
			events = append(events, "wait")
			waits++
			if deadline != selected {
				t.Fatalf("wait deadline = %s, want preselected %s", deadline, selected)
			}
			return nil
		},
	}
	if err := recovery.withPublicResponse(context.Background(), func(ctx context.Context) {
		events = append(events, "work")
		if _, ok := ctx.Deadline(); !ok {
			t.Fatal("account-dependent work has no deadline")
		}
	}); err != nil {
		t.Fatal(err)
	}
	if waits != 1 {
		t.Fatalf("response waiter calls = %d, want 1", waits)
	}
	if got := strings.Join(events, ","); got != "select,work,wait" {
		t.Fatalf("response envelope order = %q, want select,work,wait", got)
	}
}

func TestPasswordRecoveryFailureObservationIsNonBlockingAndBounded(t *testing.T) {
	entered := make(chan struct{})
	release := make(chan struct{})
	recovery := &PasswordRecovery{failed: func(context.Context, string) {
		close(entered)
		<-release
	}}

	recovery.observeFailure(context.Background(), "persistence")
	select {
	case <-entered:
	case <-time.After(time.Second):
		t.Fatal("failure observer did not start")
	}
	secondStarted := make(chan struct{}, 1)
	recovery.failed = func(context.Context, string) { secondStarted <- struct{}{} }
	recovery.observeFailure(context.Background(), "timeout")
	select {
	case <-secondStarted:
		t.Fatal("a second failure observer ran concurrently")
	case <-time.After(20 * time.Millisecond):
	}
	close(release)
	eventuallyPasswordRecovery(t, func() bool { return !recovery.reporting.Load() })
}

func TestPasswordRecoveryFailureObserverPanicIsContained(t *testing.T) {
	recovery := &PasswordRecovery{failed: func(context.Context, string) { panic("observer panic") }}
	recovery.observeFailure(context.Background(), "persistence")
	eventuallyPasswordRecovery(t, func() bool { return !recovery.reporting.Load() })
	if got := passwordRecoveryFailureStage(context.DeadlineExceeded, "persistence"); got != "timeout" {
		t.Fatalf("deadline failure stage = %q", got)
	}
	if got := passwordRecoveryFailureStage(errors.New("database unavailable"), "persistence"); got != "persistence" {
		t.Fatalf("persistence failure stage = %q", got)
	}
}

func eventuallyPasswordRecovery(t *testing.T, condition func() bool) {
	t.Helper()
	deadline := time.Now().Add(time.Second)
	for !condition() {
		if time.Now().After(deadline) {
			t.Fatal("timed out waiting for password recovery observer")
		}
		time.Sleep(time.Millisecond)
	}
}
