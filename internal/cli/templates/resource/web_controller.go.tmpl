func modelFormValues(item [[.Name]]) map[string]string {
	presented := presentItem(item)
	return map[string]string{
[[range .Fields]]		"[[.Name]]": presented.[[.GoName]],
[[end]][[range .Relationships]]		"[[.ForeignKey]]": strconv.FormatInt(item.[[.ForeignKeyGoName]], 10),
[[end]]	}
}

func presentItem(item [[.Name]]) ItemView {
	return ItemView{
		ID: item.ID,
[[range .Fields]][[if or .String .Text]]		[[.GoName]]: [[if .Nullable]]formatOptional(item.[[.GoName]], func(value string) string { return value })[[else]]item.[[.GoName]][[end]],
[[else if .Integer]]		[[.GoName]]: [[if .Nullable]]formatOptional(item.[[.GoName]], func(value int64) string { return strconv.FormatInt(value, 10) })[[else]]strconv.FormatInt(item.[[.GoName]], 10)[[end]],
[[else]]		[[.GoName]]: [[if .Nullable]]formatOptional(item.[[.GoName]], strconv.FormatBool)[[else]]strconv.FormatBool(item.[[.GoName]])[[end]],
[[end]][[end]][[range .Relationships]]		[[.GoName]]: presentAssociationLabel("[[.TargetSpec.Name]]", item.[[.ForeignKeyGoName]], func() int64 {
			if item.[[.GoName]] == nil {
				return 0
			}
			return item.[[.GoName]].ID
		}()),
[[end]]	}
}

[[if .Relationships]]func presentAssociationLabel(name string, id, loadedID int64) string {
	if id < 1 || loadedID != id {
		return "Unavailable " + name
	}
	return name + " #" + strconv.FormatInt(id, 10)
}

func presentAssociationChoices(choices []AssociationChoice, selected string) []AssociationChoiceView {
	presented := make([]AssociationChoiceView, 0, len(choices)+1)
	selectedFound := selected == ""
	for _, choice := range choices {
		value := strconv.FormatInt(choice.ID, 10)
		isSelected := value == selected
		selectedFound = selectedFound || isSelected
		presented = append(presented, AssociationChoiceView{Value: value, Label: choice.Label, Selected: isSelected})
	}
	if !selectedFound {
		presented = append(presented, AssociationChoiceView{
			Value: selected, Label: "Unavailable selection", Selected: true,
		})
	}
	return presented
}

func invalidAssociationField(err error) (string, bool) {
	var invalid *InvalidAssociationError
	if !errors.As(err, &invalid) || invalid == nil {
		return "", false
	}
	return validAssociationInputField(invalid.Field)
}

[[end]]func formatOptional[T any](value *T, format func(T) string) string {
	if value == nil {
		return ""
	}
	return format(*value)
}

func webUser(ctx *httpx.Context) (auth.User, error) {
	user, ok := auth.UserFrom(ctx)
	if !ok {
		return auth.User{}, httpx.NewHTTPError(http.StatusUnauthorized, "authentication required")
	}
	return user, nil
}

func browserState(ctx *httpx.Context) (string, string, error) {
	token, err := web.CSRFToken(ctx)
	if err != nil {
		return "", "", err
	}
	current, ok := web.Session(ctx)
	if !ok {
		return "", "", errors.New("browser session is unavailable")
	}
	var notice string
	if _, err := current.Get("notice", &notice); err != nil {
		return "", "", err
	}
	return token, notice, nil
}

func flashNotice(ctx *httpx.Context, notice string) error {
	current, ok := web.Session(ctx)
	if !ok {
		return errors.New("browser session is unavailable")
	}
	return current.Flash("notice", notice)
}

func webItemPath(id int64) string {
	return webBasePath + "/" + strconv.FormatInt(id, 10)
}

func paginationParameters(ctx *httpx.Context) (int, int, error) {
	page, err := positiveQueryInteger(ctx, "page", defaultPageNumber)
	if err != nil {
		return 0, 0, err
	}
	perPage, err := positiveQueryInteger(ctx, "per_page", defaultPageSize)
	if err != nil {
		return 0, 0, err
	}
	page, perPage = normalizePagination(page, perPage)
	return page, perPage, nil
}

func positiveQueryInteger(ctx *httpx.Context, name string, fallback int) (int, error) {
	values, present := ctx.Request.URL.Query()[name]
	if !present {
		return fallback, nil
	}
	if len(values) != 1 || strings.TrimSpace(values[0]) == "" {
		return 0, httpx.NewHTTPError(http.StatusBadRequest, name+" must be one positive integer")
	}
	value, err := strconv.Atoi(values[0])
	if err != nil || value < 1 {
		return 0, httpx.NewHTTPError(http.StatusBadRequest, name+" must be one positive integer")
	}
	return value, nil
}

func paginationURL(page, perPage int, enabled bool) string {
	if !enabled {
		return ""
	}
	query := make(url.Values)
	query.Set("page", strconv.Itoa(page))
	query.Set("per_page", strconv.Itoa(perPage))
	return webBasePath + "?" + query.Encode()
}
