func resourceJSONWithRaw(t *testing.T, field, raw string) string {
	t.Helper()
	var payload map[string]json.RawMessage
	if err := json.Unmarshal([]byte(sampleResourceJSON), &payload); err != nil {
		t.Fatal(err)
	}
	if raw == "" {
		delete(payload, field)
	} else {
		payload[field] = json.RawMessage(raw)
	}
	encoded, err := json.Marshal(payload)
	if err != nil {
		t.Fatal(err)
	}
	return string(encoded)
}

[[if .AuthorizationPolicies]]func TestJSONAuthorizationPrecedesParsingAndPersistence(t *testing.T) {
	store := session.NewMemoryStore()
	manager, err := session.NewManager(store, []byte(strings.Repeat("s", 32)), session.Cookie{UnsafeAllowHTTP: true}, time.Hour)
	if err != nil {
		t.Fatal(err)
	}
	users := fakeUsers{user: auth.User{ID: 9, Email: "ada@example.com", CredentialVersion: 1}}
	current, err := manager.Load(context.Background(), httptest.NewRequest(http.MethodGet, "/", nil))
	if err != nil {
		t.Fatal(err)
	}
	if err := current.Put("user_id", int64(9)); err != nil {
		t.Fatal(err)
	}
	if err := current.Put("credential_version", int64(1)); err != nil {
		t.Fatal(err)
	}
	seed := httptest.NewRecorder()
	if err := manager.Save(context.Background(), seed, current); err != nil {
		t.Fatal(err)
	}
	cookie := seed.Result().Cookies()[0]

	serve := func(repository *fakeRepository, authorize resource.AuthorizeFunc, method, target, body string, authenticated bool) *httptest.ResponseRecorder {
		t.Helper()
		controller, err := resource.NewController(repository, authorize)
		if err != nil {
			t.Fatal(err)
		}
		router := httpx.NewRouter()
		protected := func(handler httpx.Handler) httpx.Handler { return auth.Require(manager, users)(handler) }
		router.GET("/[[.Plural]]", protected(controller.Index))
		router.POST("/[[.Plural]]", protected(controller.Create))
		router.GET("/[[.Plural]]/{id}", protected(controller.Show))
		router.PUT("/[[.Plural]]/{id}", protected(controller.Update))
		router.DELETE("/[[.Plural]]/{id}", protected(controller.Delete))
		request := httptest.NewRequest(method, target, strings.NewReader(body))
		request.Header.Set("Content-Type", "application/json")
		if authenticated {
			request.AddCookie(cookie)
		}
		response := httptest.NewRecorder()
		router.ServeHTTP(response, request)
		return response
	}

	authorizationCalls := 0
	guestRepository := &fakeRepository{}
	guest := serve(guestRepository, func(context.Context, auth.User, resource.Action) (resource.Access, error) {
		authorizationCalls++
		return resource.AccessAll, nil
	}, http.MethodGet, "/[[.Plural]]", "", false)
	if guest.Code != http.StatusUnauthorized || authorizationCalls != 0 || guestRepository.repositoryCalls != 0 {
		t.Fatalf("guest authorization boundary: status=%d authorization=%d repository=%d", guest.Code, authorizationCalls, guestRepository.repositoryCalls)
	}

	for _, test := range []struct {
		name   string
		method string
		target string
		body   string
		action resource.Action
	}{
		{name: "list", method: http.MethodGet, target: "/[[.Plural]]?page=bad", action: resource.ActionList},
		{name: "create", method: http.MethodPost, target: "/[[.Plural]]", body: "not-json", action: resource.ActionCreate},
		{name: "view", method: http.MethodGet, target: "/[[.Plural]]/not-an-id", action: resource.ActionView},
		{name: "update", method: http.MethodPut, target: "/[[.Plural]]/not-an-id", body: "not-json", action: resource.ActionUpdate},
		{name: "delete", method: http.MethodDelete, target: "/[[.Plural]]/not-an-id", action: resource.ActionDelete},
	} {
		t.Run(test.name, func(t *testing.T) {
			repository := &fakeRepository{}
			var observed resource.Action
			response := serve(repository, func(_ context.Context, _ auth.User, action resource.Action) (resource.Access, error) {
				observed = action
				return resource.AccessDenied, nil
			}, test.method, test.target, test.body, true)
			if response.Code != http.StatusForbidden || observed != test.action || repository.repositoryCalls != 0 {
				t.Fatalf("denied %s: status=%d action=%q repository=%d: %s", test.name, response.Code, observed, repository.repositoryCalls, response.Body.String())
			}
		})
	}

	for name, authorize := range map[string]resource.AuthorizeFunc{
		"unknown access": func(context.Context, auth.User, resource.Action) (resource.Access, error) {
			return resource.Access(255), nil
		},
		"policy error": func(context.Context, auth.User, resource.Action) (resource.Access, error) {
			return resource.AccessDenied, context.Canceled
		},
	} {
		t.Run(name, func(t *testing.T) {
			repository := &fakeRepository{}
			response := serve(repository, authorize, http.MethodGet, "/[[.Plural]]", "", true)
			if response.Code != http.StatusInternalServerError || repository.repositoryCalls != 0 {
				t.Fatalf("%s did not fail closed: status=%d repository=%d: %s", name, response.Code, repository.repositoryCalls, response.Body.String())
			}
		})
	}

	allRepository := &fakeRepository{}
	all := serve(allRepository, func(context.Context, auth.User, resource.Action) (resource.Access, error) {
		return resource.AccessAll, nil
	}, http.MethodGet, "/[[.Plural]]", "", true)
	if all.Code != http.StatusOK || allRepository.repositoryCalls != 1 || allRepository.lastScope.ActorID() != 9 || !allRepository.lastScope.AllRecords() {
		t.Fatalf("all-record scope was not forwarded: status=%d calls=%d actor=%d all=%t: %s", all.Code, allRepository.repositoryCalls, allRepository.lastScope.ActorID(), allRepository.lastScope.AllRecords(), all.Body.String())
	}

	if _, err := resource.NewController(&fakeRepository{}, nil); err == nil {
		t.Fatal("nil authorization was accepted")
	}
}

[[end]]

