package auth

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
	netmail "net/mail"
	"net/url"
	"time"

	frameworkdatabase "github.com/ShanilKoshitha/goforge/database"
	frameworkmail "github.com/ShanilKoshitha/goforge/mail"
	"github.com/ShanilKoshitha/goforge/security/ratelimit"
	securitytoken "github.com/ShanilKoshitha/goforge/security/token"
)

var (
	// ErrInvalidPasswordReset is the one public failure for every invalid,
	// expired, consumed, superseded, or credentials-invalidated reset link.
	ErrInvalidPasswordReset   = errors.New("password reset link is invalid or expired")
	errRecoveryAccountMissing = errors.New("password recovery account is absent")
)

type recoveryPasswordHasher interface {
	Hash(string) (string, error)
}

type PasswordResetMailer interface {
	Message(netmail.Address, string, time.Duration) (frameworkmail.Message, error)
}

type PasswordRecoveryDelivery interface {
	Enqueue(context.Context, *sql.Tx, frameworkmail.Message) error
}

type PasswordRecovery struct {
	db        *sql.DB
	passwords recoveryPasswordHasher
	attempts  *ratelimit.Limiter
	mailer    PasswordResetMailer
	delivery  PasswordRecoveryDelivery
	origin    url.URL
	ttl       time.Duration
}

func NewPasswordRecovery(
	db *sql.DB,
	passwords recoveryPasswordHasher,
	attempts *ratelimit.Limiter,
	mailer PasswordResetMailer,
	delivery PasswordRecoveryDelivery,
	applicationURL string,
	ttl time.Duration,
) (*PasswordRecovery, error) {
	origin, err := url.Parse(applicationURL)
	if err != nil || origin.Hostname() == "" || (origin.Scheme != "http" && origin.Scheme != "https") ||
		origin.User != nil || origin.RawQuery != "" || origin.Fragment != "" || (origin.Path != "" && origin.Path != "/") {
		return nil, errors.New("password recovery application URL is invalid")
	}
	if db == nil || passwords == nil || attempts == nil || mailer == nil || delivery == nil {
		return nil, errors.New("password recovery dependencies are required")
	}
	if ttl < 5*time.Minute || ttl > 24*time.Hour {
		return nil, errors.New("password recovery lifetime must be between 5m and 24h")
	}
	return &PasswordRecovery{
		db: db, passwords: passwords, attempts: attempts, mailer: mailer,
		delivery: delivery, origin: *origin, ttl: ttl,
	}, nil
}

// Request always returns the same success for present and absent accounts. A
// per-address limiter is also silent so it cannot become an enumeration oracle.
func (recovery *PasswordRecovery) Request(ctx context.Context, email string) error {
	email = normalizeEmail(email)
	decision, err := recovery.attempts.Take(ctx, ratelimit.Key("auth-account-password-recovery", email))
	if err != nil {
		return err
	}
	if !decision.Allowed {
		return nil
	}
	issued, err := securitytoken.Issue()
	if err != nil {
		return errors.New("issue password reset token")
	}
	digest := issued.Digest()
	err = frameworkdatabase.Transaction(ctx, recovery.db, nil, func(tx *sql.Tx) error {
		var user User
		err := tx.QueryRowContext(ctx, `
			SELECT id, name, email, password_hash, credential_version, created_at, updated_at
			FROM users
			WHERE email = $1
		`, email).Scan(
			&user.ID, &user.Name, &user.Email, &user.PasswordHash,
			&user.CredentialVersion, &user.CreatedAt, &user.UpdatedAt,
		)
		if errors.Is(err, sql.ErrNoRows) {
			return errRecoveryAccountMissing
		}
		if err != nil {
			return errors.New("query password recovery account")
		}
		resetURL := recovery.resetURL(issued.Presented)
		message, err := recovery.mailer.Message(netmail.Address{Name: user.Name, Address: user.Email}, resetURL, recovery.ttl)
		if err != nil {
			return fmt.Errorf("build password reset mail: %w", err)
		}
		_, err = tx.ExecContext(ctx, `
			INSERT INTO password_reset_tokens (
				selector, user_id, secret_digest, credential_version, expires_at, created_at, updated_at
			)
			VALUES ($1, $2, $3, $4, NOW() + ($5 * INTERVAL '1 second'), NOW(), NOW())
			ON CONFLICT (user_id) DO UPDATE SET
				selector = EXCLUDED.selector,
				secret_digest = EXCLUDED.secret_digest,
				credential_version = EXCLUDED.credential_version,
				expires_at = EXCLUDED.expires_at,
				created_at = NOW(),
				updated_at = NOW()
		`, issued.Selector, user.ID, digest, user.CredentialVersion, int64(recovery.ttl/time.Second))
		if err != nil {
			return errors.New("store password reset token")
		}
		if err := recovery.delivery.Enqueue(ctx, tx, message); err != nil {
			return fmt.Errorf("enqueue password reset mail: %w", err)
		}
		return nil
	})
	if errors.Is(err, errRecoveryAccountMissing) {
		return nil
	}
	return err
}

func (recovery *PasswordRecovery) resetURL(presented string) string {
	result := recovery.origin
	result.Path = "/reset-password"
	result.RawPath = ""
	query := make(url.Values)
	query.Set("token", presented)
	result.RawQuery = query.Encode()
	return result.String()
}

// Reset locks the token and account together, verifies the digest in constant
// time, advances the credential generation, and consumes the token in one
// transaction. The credential generation invalidates every existing session.
func (recovery *PasswordRecovery) Reset(ctx context.Context, presented, replacement string) error {
	parsed, err := securitytoken.Parse(presented)
	if err != nil {
		return ErrInvalidPasswordReset
	}
	passwordHash, err := recovery.passwords.Hash(replacement)
	if err != nil {
		return fmt.Errorf("hash replacement password: %w", err)
	}
	err = frameworkdatabase.Transaction(ctx, recovery.db, nil, func(tx *sql.Tx) error {
		var digest []byte
		var userID, issuedVersion, currentVersion int64
		err := tx.QueryRowContext(ctx, `
			SELECT token.secret_digest, token.user_id, token.credential_version, users.credential_version
			FROM password_reset_tokens AS token
			JOIN users ON users.id = token.user_id
			WHERE token.selector = $1 AND token.expires_at > NOW()
			FOR UPDATE OF token, users
		`, parsed.Selector).Scan(&digest, &userID, &issuedVersion, &currentVersion)
		if errors.Is(err, sql.ErrNoRows) {
			return ErrInvalidPasswordReset
		}
		if err != nil {
			return errors.New("read password reset token")
		}
		if issuedVersion != currentVersion || !securitytoken.MatchDigest(digest, parsed) {
			return ErrInvalidPasswordReset
		}
		result, err := tx.ExecContext(ctx, `
			UPDATE users
			SET password_hash = $1, credential_version = credential_version + 1, updated_at = NOW()
			WHERE id = $2 AND credential_version = $3
		`, passwordHash, userID, currentVersion)
		if err != nil {
			return errors.New("replace account credentials")
		}
		updated, err := result.RowsAffected()
		if err != nil {
			return errors.New("inspect password reset update")
		}
		if updated != 1 {
			return ErrInvalidPasswordReset
		}
		result, err = tx.ExecContext(ctx, `DELETE FROM password_reset_tokens WHERE selector = $1`, parsed.Selector)
		if err != nil {
			return errors.New("consume password reset token")
		}
		deleted, err := result.RowsAffected()
		if err != nil {
			return errors.New("inspect password reset consumption")
		}
		if deleted != 1 {
			return ErrInvalidPasswordReset
		}
		return nil
	})
	if errors.Is(err, ErrInvalidPasswordReset) {
		return ErrInvalidPasswordReset
	}
	return err
}
