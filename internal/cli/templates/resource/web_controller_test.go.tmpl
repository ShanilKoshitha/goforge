// renderedResourceForm submits the actual successful controls, including the
// current CSRF/version/picker state, rather than inventing a page-state struct.
func renderedResourceForm(t *testing.T, body string) (string, url.Values) {
	t.Helper()
	match := regexp.MustCompile(`(?s)<form action="([^"]+)" method="post">(.*?)</form>`).FindStringSubmatch(body)
	if len(match) != 3 { t.Fatalf("missing resource POST form: %s", body) }
	values := make(url.Values)
	attribute := func(tag, key string) string {
		match := regexp.MustCompile(`\b`+key+`="([^"]*)"`).FindStringSubmatch(tag)
		if len(match) != 2 { return "" }
		return html.UnescapeString(match[1])
	}
	for _, tag := range regexp.MustCompile(`<input\b[^>]*>`).FindAllString(match[2], -1) {
		if name := attribute(tag, "name"); name != "" { values.Set(name, attribute(tag, "value")) }
	}
	for _, item := range regexp.MustCompile(`(?s)(<textarea\b[^>]*>)(.*?)</textarea>`).FindAllStringSubmatch(match[2], -1) {
		// Model HTML source newline preprocessing and the parser's ignored first
		// LF. The component emits one synthetic LF so a draft's own first LF stays.
		text := strings.ReplaceAll(strings.ReplaceAll(item[2], "\r\n", "\n"), "\r", "\n")
		values.Set(attribute(item[1], "name"), strings.TrimPrefix(html.UnescapeString(text), "\n"))
	}
	for _, item := range regexp.MustCompile(`(?s)(<select\b[^>]*>)(.*?)</select>`).FindAllStringSubmatch(match[2], -1) {
		options := regexp.MustCompile(`<option\b[^>]*>`).FindAllString(item[2], -1)
		selected := ""
		for index, option := range options { if index == 0 || strings.Contains(option, " selected") { selected = attribute(option, "value") } }
		values.Set(attribute(item[1], "name"), selected)
	}
	return html.UnescapeString(match[1]), values
}

[[end]]func scalableBrowser(t *testing.T) (*fakeRepository, http.Handler, *http.Cookie) {
	t.Helper()
	repository := &fakeRepository{}
	users := fakeUsers{user: auth.User{ID: 9, Email: "ada@example.com", CredentialVersion: 1}}
	manager, err := session.NewManager(session.NewMemoryStore(), []byte(strings.Repeat("s", 32)), session.Cookie{UnsafeAllowHTTP: true}, time.Hour)
	if err != nil { t.Fatal(err) }
	renderer, err := views.New()
	if err != nil { t.Fatal(err) }
	webController, err := resource.NewWebController(repository, renderer, resource.Authorize)
	if err != nil { t.Fatal(err) }
	jsonController, err := resource.NewController(repository, resource.Authorize)
	if err != nil { t.Fatal(err) }
	router := httpx.NewRouter()
	router.Use(httpx.MethodOverride("/app/"))
	protect := func(handler httpx.Handler) httpx.Handler { return web.Sessions(manager)(auth.RequireWeb(users)(web.CSRF()(handler))) }
	router.GET("/app/[[.Plural]]", protect(webController.Index))
	router.GET("/app/[[.Plural]]/new", protect(webController.New))
	router.POST("/app/[[.Plural]]", protect(webController.Create))
	router.GET("/app/[[.Plural]]/{id}/edit", protect(webController.Edit))
	router.PUT("/app/[[.Plural]]/{id}", protect(webController.Update))
	router.GET("/[[.Plural]]", auth.Require(manager, users)(jsonController.Index))
	current, err := manager.Load(context.Background(), httptest.NewRequest(http.MethodGet, "/", nil))
	if err != nil { t.Fatal(err) }
	if err := current.Put("user_id", int64(9)); err != nil { t.Fatal(err) }
	if err := current.Put("credential_version", int64(1)); err != nil { t.Fatal(err) }
	seed := httptest.NewRecorder()
	if err := manager.Save(context.Background(), seed, current); err != nil { t.Fatal(err) }
	return repository, router, seed.Result().Cookies()[0]
}

