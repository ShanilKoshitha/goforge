func resourceJSONWithRaw(t *testing.T, field, raw string) string {
	t.Helper()
	var payload map[string]json.RawMessage
	if err := json.Unmarshal([]byte(sampleResourceJSON), &payload); err != nil {
		t.Fatal(err)
	}
	if raw == "" {
		delete(payload, field)
	} else {
		payload[field] = json.RawMessage(raw)
	}
	encoded, err := json.Marshal(payload)
	if err != nil {
		t.Fatal(err)
	}
	return string(encoded)
}

func TestCreateRequiresAuthenticationAndValidatesInput(t *testing.T) {
