package requests

import (
	"bytes"
	"encoding/json"
	"net/http"
	"net/mail"
	"strings"

	"github.com/ShanilKoshitha/goforge/httpx"
	"github.com/ShanilKoshitha/goforge/validation"
)

type ForgotPasswordRequest struct {
	Email string `json:"email" form:"email"`

	emailInput validation.Input[string]
}

func (request *ForgotPasswordRequest) DecodeJSON(ctx *httpx.Context) error {
	var body *struct {
		Email json.RawMessage `json:"email"`
	}
	if err := ctx.BindJSON(&body); err != nil {
		return err
	}
	if body == nil {
		return httpx.NewHTTPError(http.StatusBadRequest, "JSON body must be an object")
	}
	var err error
	request.Email, request.emailInput, err = passwordRecoveryDecodeString("email", body.Email, passwordRecoveryNormalizeEmail)
	return err
}

func (request *ForgotPasswordRequest) DecodeForm(ctx *httpx.Context) error {
	form, err := ctx.Form()
	if err != nil {
		return err
	}
	request.Email, request.emailInput, err = passwordRecoveryFormString(form, "email", passwordRecoveryNormalizeEmail)
	return err
}

func (request ForgotPasswordRequest) Validate() validation.Report {
	email := passwordRecoveryFallbackInput(request.emailInput, request.Email, passwordRecoveryNormalizeEmail)
	return validation.Apply("email", email,
		validation.Required[string](), validation.StringLength(3, 320), passwordRecoveryEmailRule())
}

type ResetPasswordRequest struct {
	Token                string `json:"token" form:"token"`
	Password             string `json:"password" form:"password"`
	PasswordConfirmation string `json:"password_confirmation" form:"password_confirmation"`

	tokenInput                validation.Input[string]
	passwordInput             validation.Input[string]
	passwordConfirmationInput validation.Input[string]
}

func (request *ResetPasswordRequest) DecodeJSON(ctx *httpx.Context) error {
	var body *struct {
		Token                json.RawMessage `json:"token"`
		Password             json.RawMessage `json:"password"`
		PasswordConfirmation json.RawMessage `json:"password_confirmation"`
	}
	if err := ctx.BindJSON(&body); err != nil {
		return err
	}
	if body == nil {
		return httpx.NewHTTPError(http.StatusBadRequest, "JSON body must be an object")
	}
	var err error
	if request.Token, request.tokenInput, err = passwordRecoveryDecodeString("token", body.Token, passwordRecoveryIdentity); err != nil {
		return err
	}
	if request.Password, request.passwordInput, err = passwordRecoveryDecodeString("password", body.Password, passwordRecoveryIdentity); err != nil {
		return err
	}
	request.PasswordConfirmation, request.passwordConfirmationInput, err = passwordRecoveryDecodeString(
		"password_confirmation", body.PasswordConfirmation, passwordRecoveryIdentity,
	)
	return err
}

func (request *ResetPasswordRequest) DecodeForm(ctx *httpx.Context) error {
	form, err := ctx.Form()
	if err != nil {
		return err
	}
	if request.Token, request.tokenInput, err = passwordRecoveryFormString(form, "token", passwordRecoveryIdentity); err != nil {
		return err
	}
	if request.Password, request.passwordInput, err = passwordRecoveryFormString(form, "password", passwordRecoveryIdentity); err != nil {
		return err
	}
	request.PasswordConfirmation, request.passwordConfirmationInput, err = passwordRecoveryFormString(
		form, "password_confirmation", passwordRecoveryIdentity,
	)
	return err
}

func (request ResetPasswordRequest) Validate() validation.Report {
	token := passwordRecoveryFallbackInput(request.tokenInput, request.Token, passwordRecoveryIdentity)
	password := passwordRecoveryFallbackInput(request.passwordInput, request.Password, passwordRecoveryIdentity)
	confirmation := passwordRecoveryFallbackInput(
		request.passwordConfirmationInput, request.PasswordConfirmation, passwordRecoveryIdentity,
	)
	confirmed := validation.RuleFunc[string](func(input validation.Input[string]) []validation.Issue {
		value, present := input.Value()
		original, originalPresent := password.Value()
		if present && originalPresent && value != original {
			return []validation.Issue{{Code: "password.confirmed", Message: "must match password"}}
		}
		return nil
	})
	return validation.Join(
		validation.Apply("token", token,
			validation.Required[string](), validation.StringLength(1, 256)),
		validation.Apply("password", password,
			validation.Required[string](), validation.StringLength(12, 128)),
		validation.Apply("password_confirmation", confirmation,
			validation.Required[string](), confirmed),
	)
}

func passwordRecoveryDecodeString(field string, raw json.RawMessage, normalize func(string) string) (string, validation.Input[string], error) {
	if raw == nil {
		return "", validation.Missing[string](), nil
	}
	if bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
		return "", validation.Null[string](), nil
	}
	var value string
	if err := json.Unmarshal(raw, &value); err != nil {
		return "", validation.Missing[string](), httpx.NewHTTPError(http.StatusBadRequest, field+" must be a string").WithCause(err)
	}
	value = normalize(value)
	if value == "" {
		return "", validation.Empty[string](), nil
	}
	return value, validation.Present(value), nil
}

func passwordRecoveryFormString(form httpx.Form, field string, normalize func(string) string) (string, validation.Input[string], error) {
	value, err := form.Value(field)
	if err != nil {
		return "", validation.Missing[string](), err
	}
	if !form.Has(field) {
		return "", validation.Missing[string](), nil
	}
	value = normalize(value)
	if value == "" {
		return "", validation.Empty[string](), nil
	}
	return value, validation.Present(value), nil
}

func passwordRecoveryFallbackInput(input validation.Input[string], value string, normalize func(string) string) validation.Input[string] {
	if input.State() != validation.StateMissing || value == "" {
		return input
	}
	value = normalize(value)
	if value == "" {
		return validation.Empty[string]()
	}
	return validation.Present(value)
}

func passwordRecoveryEmailRule() validation.Rule[string] {
	return validation.RuleFunc[string](func(input validation.Input[string]) []validation.Issue {
		value, present := input.Value()
		if !present {
			return nil
		}
		address, err := mail.ParseAddress(value)
		if err != nil || address.Address != value {
			return []validation.Issue{{Code: "string.email", Message: "must be a valid email address"}}
		}
		return nil
	})
}

func passwordRecoveryNormalizeEmail(value string) string {
	return strings.ToLower(strings.TrimSpace(value))
}

func passwordRecoveryIdentity(value string) string { return value }
