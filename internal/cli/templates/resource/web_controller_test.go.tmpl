func TestBrowserChoiceRefreshRejectsUnsafeStateAndPreservesVersions(t *testing.T) {
	repository, router, cookie := scalableBrowser(t)
	page := browserRequest(router, http.MethodGet, "/app/[[.Plural]]/new", nil, cookie)
	token := browserCSRFToken(t, page.Body.String())
	cookie = responseCookie(page, cookie)
[[with index .Relationships 0]]	for _, mutate := range []func(url.Values){
		func(values url.Values) { values.Set("choice[unknown][page]", "1") },
		func(values url.Values) { values.Set("choice[[`[`]][[.Name]]][page]", "10001") },
		func(values url.Values) { values.Set("choice[[`[`]][[.Name]]][id]", "0") },
		func(values url.Values) { values.Add("choice[[`[`]][[.Name]]][page]", "1") },
		func(values url.Values) { values.Set("choice[[`[`]][[.Name]]][q]", "bad\x00text") },
		func(values url.Values) { values.Set("choice[[`[`]][[.Name]]][q]", strings.Repeat("é", 201)) },
		func(values url.Values) { values.Set("choice[[`[`]][[.Name]]][q]", "text"); values.Set("choice[[`[`]][[.Name]]][id]", "7") },
	} {
		values := sampleResourceFormValues()
		values.Set("_token", token)
		values.Set("choice[[`[`]][[.Name]]][page]", "1")
		mutate(values)
		before := repository.choiceCalls
		response := browserRequest(router, http.MethodPost, "/app/[[$.Plural]]", values, cookie)
		if response.Code != http.StatusBadRequest || repository.choiceCalls != before || repository.repositoryCalls != 0 || repository.item.ID != 0 { t.Fatalf("unsafe choice state queried or wrote: %d %v: %s", response.Code, values, response.Body.String()) }
	}
	refresh := sampleResourceFormValues()
	refresh.Set("intent", "choice:[[.Name]]:lookup")
	refresh.Set("choice[[`[`]][[.Name]]][id]", "7")
	beforeChoices := repository.choiceCalls
	missingCSRF := browserRequest(router, http.MethodPost, "/app/[[$.Plural]]", refresh, cookie)
	if missingCSRF.Code != http.StatusForbidden || repository.choiceCalls != beforeChoices { t.Fatalf("refresh bypassed CSRF: %d", missingCSRF.Code) }
	// A selected authorized row need not appear on the current result page.
	repository.choicePages = map[string]resource.AssociationChoicePage{
		"[[.Name]]": {Items: []resource.AssociationChoice{{ID: 11, Label: "different page"}}, Selected: &resource.AssociationChoice{ID: 7, Label: "safe <selected>"}, Number: 1},
	}
	refresh.Set("_token", token)
	selected := browserRequest(router, http.MethodPost, "/app/[[$.Plural]]", refresh, cookie)
	if selected.Code != http.StatusOK || !strings.Contains(selected.Body.String(), `value="7" selected`) || strings.Contains(selected.Body.String(), "safe <selected>") || !strings.Contains(selected.Body.String(), "safe &lt;selected&gt;") { t.Fatalf("outside-page selection lost or unescaped: %d %s", selected.Code, selected.Body.String()) }
	repository.choicePages = nil
	cookie = responseCookie(selected, cookie)
	// Refresh keeps a valid stale version, while repairing an invalid one from
	// the authorized current member. A correction cannot bypass the later CAS.
	repository.item = resource.[[$.Name]]{ID: 1, UserID: 9, Version: 2}
	edit := browserRequest(router, http.MethodGet, "/app/[[$.Plural]]/1/edit", nil, cookie)
	values := updatedResourceFormValues()
	values.Set("_token", browserCSRFToken(t, edit.Body.String()))
	values.Set("_method", http.MethodPut)
	values.Set("intent", "choice:[[.Name]]:lookup")
	values.Set("choice[[`[`]][[.Name]]][id]", "7")
	values.Set("version", "1")
	values.Set("validation_attempted", "1")
	stale := browserRequest(router, http.MethodPost, "/app/[[$.Plural]]/1", values, responseCookie(edit, cookie))
	if stale.Code != http.StatusOK || browserVersion(t, stale.Body.String()) != "1" || repository.item.Version != 2 || !reflect.DeepEqual(repository.updatedAttributes, resource.Attributes{}) { t.Fatalf("refresh replaced stale version or wrote: %d %s", stale.Code, stale.Body.String()) }
	values.Set("_token", browserCSRFToken(t, stale.Body.String()))
	values.Set("intent", "save")
	conflict := browserRequest(router, http.MethodPost, "/app/[[$.Plural]]/1", values, responseCookie(stale, cookie))
	if conflict.Code != http.StatusConflict || repository.item.Version != 2 || !reflect.DeepEqual(repository.updatedAttributes, resource.Attributes{}) { t.Fatalf("refresh bypassed optimistic conflict: %d %s", conflict.Code, conflict.Body.String()) }
	values.Set("_token", browserCSRFToken(t, conflict.Body.String()))
	values.Set("intent", "choice:[[.Name]]:lookup")
	values.Set("version", "not-a-version")
	repaired := browserRequest(router, http.MethodPost, "/app/[[$.Plural]]/1", values, responseCookie(conflict, cookie))
	if repaired.Code != http.StatusUnprocessableEntity || browserVersion(t, repaired.Body.String()) != "2" || repository.item.Version != 2 { t.Fatalf("invalid refresh version was not correctable: %d %s", repaired.Code, repaired.Body.String()) }
	values.Set("_token", browserCSRFToken(t, repaired.Body.String()))
	repository.item.UserID = 27
	beforeChoices = repository.choiceCalls
	foreign := browserRequest(router, http.MethodPost, "/app/[[$.Plural]]/1", values, responseCookie(repaired, cookie))
	if foreign.Code != http.StatusNotFound || repository.choiceCalls != beforeChoices || strings.Contains(foreign.Body.String(), `name="version"`) { t.Fatalf("hidden member exposed choices/form: %d %s", foreign.Code, foreign.Body.String()) }
[[end]]}

