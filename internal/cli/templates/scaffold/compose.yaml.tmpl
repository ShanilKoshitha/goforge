services:
  postgres:
    image: postgres:18-alpine
    environment:
      POSTGRES_DB: goforge
      POSTGRES_USER: goforge
      POSTGRES_PASSWORD: goforge
    ports:
      - "127.0.0.1:5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U goforge -d goforge"]
      interval: 2s
      timeout: 3s
      retries: 15
    volumes:
      - postgres-data:/var/lib/postgresql

volumes:
  postgres-data:
