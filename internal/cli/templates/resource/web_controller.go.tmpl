func (controller *WebController) renderForm(ctx *httpx.Context, userID int64, status int, name string, page FormPage) error {
	token, err := web.CSRFToken(ctx)
	if err != nil {
		return err
	}
	page.Form.CSRFToken = token
	if page.Errors == nil {
		page.Errors = make(validation.Errors)
	}
	page.Form.ValidationErrors = page.Errors
	page.Form.OldValues = make(map[string]string, len(page.Values))
	for name, value := range page.Values {
		page.Form.OldValues[name] = value
	}
[[range .Relationships]]	[[.Name]]Choices, err := controller.repository.[[.GoName]]Choices(ctx.Request.Context(), userID)
	if errors.Is(err, ErrAssociationChoicesOverflow) {
		return httpx.NewHTTPError(http.StatusConflict, "too many [[.TargetSpec.Name]] choices to display safely")
	}
	if err != nil {
		return err
	}
	page.[[.GoName]]Choices = presentAssociationChoices([[.Name]]Choices, page.Values["[[.ForeignKey]]"])
[[end]]	return web.Render(ctx, controller.views, status, name, page)
}

