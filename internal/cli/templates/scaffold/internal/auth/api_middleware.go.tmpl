package auth

import (
	"context"
	"errors"
	"net/http"
	"strings"

	"github.com/ShanilKoshitha/goforge/httpx"
	"github.com/ShanilKoshitha/goforge/session"
)

type personalTokenContextKey struct{}

// TokenIDFrom reports the non-secret personal-token ID for a bearer-authenticated
// request. Its absence on a protected route means session authentication.
func TokenIDFrom(ctx context.Context) (int64, bool) {
	id, ok := ctx.Value(personalTokenContextKey{}).(int64)
	return id, ok && id > 0
}

// RequireAPI preserves cookie-session authentication when Authorization is
// absent. Any Authorization header is authoritative and must be one exact
// Bearer credential; it never falls back to a valid cookie.
func RequireAPI(sessions *session.Manager, users UserReader, tokens PersonalTokenAuthenticator) httpx.Middleware {
	requireSession := Require(sessions, users)
	return func(next httpx.Handler) httpx.Handler {
		sessionHandler := requireSession(next)
		return func(ctx *httpx.Context) error {
			values := ctx.Request.Header.Values("Authorization")
			if len(values) == 0 {
				return sessionHandler(ctx)
			}
			if len(values) != 1 || tokens == nil {
				return bearerUnauthorized(ctx)
			}
			const scheme = "Bearer "
			value := values[0]
			if !strings.HasPrefix(value, scheme) || len(value) == len(scheme) || strings.TrimSpace(value) != value || strings.ContainsAny(value[len(scheme):], " \t\r\n") {
				return bearerUnauthorized(ctx)
			}
			authentication, err := tokens.Authenticate(ctx.Request.Context(), value[len(scheme):])
			if errors.Is(err, ErrInvalidPersonalToken) {
				return bearerUnauthorized(ctx)
			}
			if err != nil {
				return err
			}
			if authentication.TokenID < 1 || authentication.User.ID < 1 {
				return errors.New("personal access token authenticator returned an invalid identity")
			}
			requestContext := context.WithValue(ctx.Request.Context(), personalTokenContextKey{}, authentication.TokenID)
			ctx.Request = ctx.Request.WithContext(requestContext)
			ctx.Set(userContextKey, authentication.User)
			return next(ctx)
		}
	}
}

func bearerUnauthorized(ctx *httpx.Context) error {
	ctx.Response.Header().Set("WWW-Authenticate", "Bearer")
	return httpx.NewHTTPError(http.StatusUnauthorized, "authentication required")
}
