package [[.Package]]

import "[[.Module]]/internal/models"

// [[.Name]] preserves the resource package API while the application-owned
// model and generated ORM descriptors live in internal/models.
type [[.Name]] = models.[[.Name]]

// Attributes is the complete set of application-writable values for [[.Name]].
// Identity, ownership, timestamps, optimistic versions, and relationships are
// deliberately absent and cannot be mass-assigned.
type Attributes struct {
[[range .Fields]]	[[.GoName]] [[.GoType]]
[[end]]}
[[if .Relationships]]

// AssociationIDs is the complete set of relationship keys accepted by writes.
// Keeping these keys separate prevents generic attribute mass assignment.
type AssociationIDs struct {
[[range .Relationships]]	[[.ForeignKeyGoName]] int64
[[end]]}

func validAssociationInputField(field string) (string, bool) {
	switch field {
[[range .Relationships]]	case "[[.ForeignKey]]":
		return field, true
[[end]]	default:
		return "", false
	}
}
[[end]]
