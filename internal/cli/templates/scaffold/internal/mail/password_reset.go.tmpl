package mail

import (
	"bytes"
	_ "embed"
	"fmt"
	"html/template"
	netmail "net/mail"
	texttemplate "text/template"
	"time"

	frameworkmail "github.com/ShanilKoshitha/goforge/mail"
	"github.com/ShanilKoshitha/goforge/view"
)

//go:embed templates/password_reset.txt
var passwordResetTextSource string

type PasswordResetData struct {
	ResetURL string
	ExpiresIn time.Duration
}

type PasswordReset struct {
	from netmail.Address
	html *template.Template
	text *texttemplate.Template
}

func NewPasswordReset(renderer *view.Engine, from string) (*PasswordReset, error) {
	if renderer == nil {
		return nil, fmt.Errorf("password reset renderer is required")
	}
	fromAddress, err := netmail.ParseAddress(from)
	if err != nil {
		return nil, fmt.Errorf("parse password reset sender: %w", err)
	}
	text, err := texttemplate.New("password_reset").Option("missingkey=error").Parse(passwordResetTextSource)
	if err != nil {
		return nil, fmt.Errorf("parse password reset text template: %w", err)
	}
	return &PasswordReset{from: *fromAddress, html: renderer.Templates(), text: text}, nil
}

func (mail *PasswordReset) Message(to netmail.Address, resetURL string, expiresIn time.Duration) (frameworkmail.Message, error) {
	if mail == nil {
		return frameworkmail.Message{}, fmt.Errorf("password reset mail is required")
	}
	data := PasswordResetData{ResetURL: resetURL, ExpiresIn: expiresIn}
	var textBody, htmlBody bytes.Buffer
	if err := mail.text.Execute(&textBody, data); err != nil {
		return frameworkmail.Message{}, fmt.Errorf("render password reset text: %w", err)
	}
	if err := mail.html.ExecuteTemplate(&htmlBody, "mail/password_reset", data); err != nil {
		return frameworkmail.Message{}, fmt.Errorf("render password reset HTML: %w", err)
	}
	return frameworkmail.NewMessage(frameworkmail.MessageOptions{
		From: mail.from, To: []netmail.Address{to}, Subject: "Reset your password",
		Text: textBody.String(), HTML: htmlBody.String(),
	})
}
