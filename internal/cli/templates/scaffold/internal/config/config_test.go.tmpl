package config

import (
	"strings"
	"testing"
	"time"
)

func TestHTTPConfigurationHasBoundedDefaultsAndRejectsInvalidLimits(t *testing.T) {
	setValidRecoveryConfiguration(t)
	t.Setenv("DATABASE_URL", "postgres://localhost/application")
	t.Setenv("SESSION_SECRET", strings.Repeat("s", 32))
	settings, err := Load()
	if err != nil {
		t.Fatal(err)
	}
	if settings.RequestTimeout != 15*time.Second || settings.ReadTimeout != 30*time.Second ||
		settings.WriteTimeout != 30*time.Second || settings.IdleTimeout != 2*time.Minute ||
		settings.MaxHeaderBytes != 1<<20 || settings.SessionIdleLifetime != 2*time.Hour ||
		settings.SessionAbsoluteLifetime != 24*time.Hour {
		t.Fatalf("unexpected HTTP defaults: %+v", settings)
	}

	t.Setenv("APP_REQUEST_TIMEOUT", "31s")
	t.Setenv("APP_WRITE_TIMEOUT", "30s")
	t.Setenv("APP_MAX_HEADER_BYTES", "1")
	if _, err := Load(); err == nil || !strings.Contains(err.Error(), "APP_REQUEST_TIMEOUT") || !strings.Contains(err.Error(), "APP_MAX_HEADER_BYTES") {
		t.Fatalf("invalid HTTP limits were not accumulated: %v", err)
	}
}

func TestSessionConfigurationRejectsInvalidLifetimePolicy(t *testing.T) {
	setValidRecoveryConfiguration(t)
	t.Setenv("DATABASE_URL", "postgres://localhost/application")
	t.Setenv("SESSION_SECRET", strings.Repeat("s", 32))
	t.Setenv("SESSION_IDLE_LIFETIME", "4h")
	t.Setenv("SESSION_ABSOLUTE_LIFETIME", "2h")
	if _, err := Load(); err == nil || !strings.Contains(err.Error(), "SESSION_ABSOLUTE_LIFETIME") {
		t.Fatalf("invalid session lifetime policy was accepted: %v", err)
	}
}

func TestBackgroundConfigurationDoesNotRequireHTTPSessionSecret(t *testing.T) {
	setValidWorkerMailConfiguration(t)
	t.Setenv("DATABASE_URL", "postgres://localhost/application")
	t.Setenv("SESSION_SECRET", "")
	for key, value := range map[string]string{
		"JOB_QUEUES":             "default",
		"JOB_CONCURRENCY":        "4",
		"JOB_POLL_INTERVAL":      "1s",
		"JOB_LEASE_DURATION":     "30s",
		"JOB_HEARTBEAT_INTERVAL": "10s",
		"JOB_OPERATION_TIMEOUT":  "5s",
		"JOB_SHUTDOWN_TIMEOUT":   "15s",
	} {
		t.Setenv(key, value)
	}
	if _, err := LoadDatabase(); err != nil {
		t.Fatalf("database config unexpectedly required HTTP settings: %v", err)
	}
	settings, err := LoadWorker()
	if err != nil {
		t.Fatalf("worker config unexpectedly required HTTP settings: %v", err)
	}
	if settings.JobConcurrency != 4 || settings.JobQueues != "default" {
		t.Fatalf("unexpected worker defaults: %+v", settings)
	}
}

func TestSchedulerConfigurationIsIsolatedBoundedAndHasOperationalDefaults(t *testing.T) {
	t.Setenv("DATABASE_URL", "postgres://localhost/application")
	t.Setenv("SESSION_SECRET", "")
	t.Setenv("MAIL_OUTBOX_KEY", "")
	settings, err := LoadScheduler()
	if err != nil {
		t.Fatal(err)
	}
	if settings.SchedulePollInterval != 15*time.Second || settings.ScheduleOperationTimeout != 5*time.Second {
		t.Fatalf("unexpected scheduler defaults: %+v", settings)
	}

	t.Setenv("SCHEDULE_POLL_INTERVAL", "500ms")
	t.Setenv("SCHEDULE_OP_TIMEOUT", "2m")
	if _, err := LoadScheduler(); err == nil || !strings.Contains(err.Error(), "SCHEDULE_POLL_INTERVAL") || !strings.Contains(err.Error(), "SCHEDULE_OP_TIMEOUT") {
		t.Fatalf("invalid scheduler bounds were not accumulated: %v", err)
	}
}

func TestRecoveryConfigurationRejectsUnsafeOriginsAndInvalidKeys(t *testing.T) {
	setValidRecoveryConfiguration(t)
	t.Setenv("DATABASE_URL", "postgres://localhost/application")
	t.Setenv("SESSION_SECRET", strings.Repeat("s", 32))
	t.Setenv("APP_URL", "http://example.com/reset?token=leak")
	t.Setenv("MAIL_OUTBOX_KEY", "predictable")
	if _, err := Load(); err == nil || !strings.Contains(err.Error(), "APP_URL") || !strings.Contains(err.Error(), "MAIL_OUTBOX_KEY") {
		t.Fatalf("unsafe recovery configuration was accepted: %v", err)
	}
}

func TestWorkerAllowsPlaintextSMTPOnlyOnLocalLoopback(t *testing.T) {
	setValidWorkerMailConfiguration(t)
	t.Setenv("DATABASE_URL", "postgres://localhost/application")
	t.Setenv("APP_ENV", "production")
	t.Setenv("MAIL_SMTP_ADDRESS", "smtp.example.com:25")
	t.Setenv("MAIL_SMTP_TLS", "none")
	if _, err := LoadWorker(); err == nil || !strings.Contains(err.Error(), "loopback SMTP") {
		t.Fatalf("production plaintext SMTP was accepted: %v", err)
	}

	t.Setenv("APP_ENV", "local")
	t.Setenv("MAIL_SMTP_ADDRESS", "127.0.0.1:1025")
	if _, err := LoadWorker(); err != nil {
		t.Fatalf("local loopback SMTP was rejected: %v", err)
	}
}

func setValidRecoveryConfiguration(t *testing.T) {
	t.Helper()
	t.Setenv("APP_ENV", "production")
	t.Setenv("APP_URL", "https://example.test")
	t.Setenv("AUTH_PASSWORD_RESET_TTL", "30m")
	t.Setenv("MAIL_FROM", "GoForge <no-reply@example.test>")
	t.Setenv("MAIL_OUTBOX_KEY", strings.Repeat("A", 43))
}

func setValidWorkerMailConfiguration(t *testing.T) {
	t.Helper()
	t.Setenv("APP_ENV", "production")
	t.Setenv("MAIL_SMTP_ADDRESS", "smtp.example.test:465")
	t.Setenv("MAIL_SMTP_TLS", "implicit")
	t.Setenv("MAIL_SMTP_SERVER_NAME", "smtp.example.test")
	t.Setenv("MAIL_SMTP_TIMEOUT", "10s")
	t.Setenv("MAIL_OUTBOX_KEY", strings.Repeat("A", 43))
}
