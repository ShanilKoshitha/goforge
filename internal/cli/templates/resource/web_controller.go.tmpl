func (controller *WebController) Update(ctx *httpx.Context) error {
	user, err := webUser(ctx)
	if err != nil {
		return err
	}
[[if .AuthorizationPolicies]]	scope, err := requestAuthorizationScope(ctx, user, ActionUpdate, controller.authorize)
	if err != nil {
		return err
	}
[[end]]	id, err := resourceID(ctx)
	if err != nil {
		return err
	}
	var request WriteRequest
	if err := request.DecodeForm(ctx); err != nil {
		return err
	}
	if problems := request.ValidateUpdate(); !problems.Empty() {
[[if and .AuthorizationPolicies .Relationships]]		formOwnerID, err := controller.formOwnerForItem(ctx, scope, id)
		if err != nil {
			return err
		}
[[end]]		return controller.renderForm(ctx, [[if and .AuthorizationPolicies .Relationships]]formOwnerID[[else]]user.ID[[end]], http.StatusUnprocessableEntity, "pages/[[.Plural]]/edit", FormPage{
			Title: "Edit [[.Name]]", Action: webItemPath(id), Method: http.MethodPut,
			Submit: "Save [[.Name]]", Values: request.FormValues(), Version: request.Version, Errors: problems.Messages(),
		})
	}
	if request.Version == nil {
		return httpx.NewHTTPError(http.StatusBadRequest, "version is required for browser updates")
	}
	item, err := controller.repository.Update(ctx.Request.Context(), [[if .AuthorizationPolicies]]scope[[else]]user.ID[[end]], id, request.Attributes[[if .Relationships]], request.Associations[[end]], request.Version)
	if errors.Is(err, ErrNotFound) {
		return httpx.NewHTTPError(http.StatusNotFound, "[[.Package]] not found")
	}
	if errors.Is(err, ErrStale) {
		fresh, findErr := controller.repository.Find(ctx.Request.Context(), [[if .AuthorizationPolicies]]scope[[else]]user.ID[[end]], id)
		if errors.Is(findErr, ErrNotFound) {
			return httpx.NewHTTPError(http.StatusNotFound, "[[.Package]] not found")
		}
		if findErr != nil {
			return findErr
		}
		return controller.renderForm(ctx, [[if .AuthorizationPolicies]]fresh.UserID[[else]]user.ID[[end]], http.StatusConflict, "pages/[[.Plural]]/edit", FormPage{
			Title: "Edit [[.Name]]", Action: webItemPath(id), Method: http.MethodPut,
			Submit: "Save [[.Name]]", Values: request.FormValues(), Version: &fresh.Version,
			Errors: validation.Errors{"version": {"was changed by another request; review and try again"}},
		})
	}
[[if .Relationships]]	if field, invalid := invalidAssociationField(err); invalid {
[[if .AuthorizationPolicies]]		formOwnerID, scopeErr := controller.formOwnerForItem(ctx, scope, id)
		if scopeErr != nil {
			return scopeErr
		}
[[end]]		return controller.renderForm(ctx, [[if .AuthorizationPolicies]]formOwnerID[[else]]user.ID[[end]], http.StatusUnprocessableEntity, "pages/[[.Plural]]/edit", FormPage{
			Title: "Edit [[.Name]]", Action: webItemPath(id), Method: http.MethodPut,
			Submit: "Save [[.Name]]", Values: request.FormValues(), Version: request.Version,
			Errors: validation.Errors{field: {"is not available"}},
		})
	}
[[end]]	if err != nil {
		return err
	}
	if err := flashNotice(ctx, "[[.Name]] updated."); err != nil {
		return err
	}
	return web.Redirect(ctx, webItemPath(item.ID))
}

