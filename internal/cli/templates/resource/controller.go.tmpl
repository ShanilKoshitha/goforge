package [[.Package]]

import (
	"errors"
	"net/http"
	"strconv"

	"github.com/ShanilKoshitha/goforge/httpx"
[[if .Relationships]]	"github.com/ShanilKoshitha/goforge/validation"
[[end]]

	"[[.Module]]/internal/auth"
)

type Controller struct{ repository Repository }

func NewController(repository Repository) *Controller {
	return &Controller{repository: repository}
}


func (controller *Controller) Index(ctx *httpx.Context) error {
	user, ok := auth.UserFrom(ctx)
	if !ok {
		return httpx.NewHTTPError(http.StatusUnauthorized, "authentication required")
	}
	items, err := controller.repository.List(ctx.Request.Context(), user.ID)
	if err != nil {
		return err
	}
	return ctx.JSON(http.StatusOK, map[string]any{"data": items})
}

func (controller *Controller) Create(ctx *httpx.Context) error {
	user, ok := auth.UserFrom(ctx)
	if !ok {
		return httpx.NewHTTPError(http.StatusUnauthorized, "authentication required")
	}
	var request WriteRequest
	if err := request.DecodeJSON(ctx); err != nil {
		return err
	}
	if problems := request.ValidateCreate(); !problems.Empty() {
		return httpx.NewHTTPError(http.StatusUnprocessableEntity, "validation failed").WithDetails(problems)
	}
	item, err := controller.repository.Create(ctx.Request.Context(), user.ID, request.Attributes[[if .Relationships]], request.Associations[[end]])
	[[if .Relationships]]err = associationHTTPError(err)
	[[end]]if err != nil {
		return err
	}
	return ctx.JSON(http.StatusCreated, map[string]any{"data": item})
}

func (controller *Controller) Show(ctx *httpx.Context) error {
	user, ok := auth.UserFrom(ctx)
	if !ok {
		return httpx.NewHTTPError(http.StatusUnauthorized, "authentication required")
	}
	id, err := resourceID(ctx)
	if err != nil {
		return err
	}
	item, err := controller.repository.Find(ctx.Request.Context(), user.ID, id)
	if errors.Is(err, ErrNotFound) {
		return httpx.NewHTTPError(http.StatusNotFound, "[[.Package]] not found")
	}
	if err != nil {
		return err
	}
	return ctx.JSON(http.StatusOK, map[string]any{"data": item})
}

func (controller *Controller) Update(ctx *httpx.Context) error {
	user, ok := auth.UserFrom(ctx)
	if !ok {
		return httpx.NewHTTPError(http.StatusUnauthorized, "authentication required")
	}
	id, err := resourceID(ctx)
	if err != nil {
		return err
	}
	var request WriteRequest
	if err := request.DecodeJSON(ctx); err != nil {
		return err
	}
	if problems := request.ValidateUpdate(); !problems.Empty() {
		return httpx.NewHTTPError(http.StatusUnprocessableEntity, "validation failed").WithDetails(problems)
	}
	item, err := controller.repository.Update(ctx.Request.Context(), user.ID, id, request.Attributes[[if .Relationships]], request.Associations[[end]], request.Version)
	if errors.Is(err, ErrNotFound) {
		return httpx.NewHTTPError(http.StatusNotFound, "[[.Package]] not found")
	}
	if errors.Is(err, ErrStale) {
		return httpx.NewHTTPError(http.StatusConflict, "[[.Package]] was changed; fetch the latest version and retry")
	}
	[[if .Relationships]]err = associationHTTPError(err)
	[[end]]if err != nil {
		return err
	}
	return ctx.JSON(http.StatusOK, map[string]any{"data": item})
}

func (controller *Controller) Delete(ctx *httpx.Context) error {
	user, ok := auth.UserFrom(ctx)
	if !ok {
		return httpx.NewHTTPError(http.StatusUnauthorized, "authentication required")
	}
	id, err := resourceID(ctx)
	if err != nil {
		return err
	}
	if err := controller.repository.Delete(ctx.Request.Context(), user.ID, id); errors.Is(err, ErrNotFound) {
		return httpx.NewHTTPError(http.StatusNotFound, "[[.Package]] not found")
	[[if .OwnerCandidateKey]]} else if errors.Is(err, ErrInUse) {
		return httpx.NewHTTPError(http.StatusConflict, "[[.Package]] is still in use")
	[[end]]} else if err != nil {
		return err
	}
	return ctx.NoContent(http.StatusNoContent)
}

[[if .Relationships]]func associationHTTPError(err error) error {
	var invalid *InvalidAssociationError
	if !errors.As(err, &invalid) {
		return err
	}
	details := validation.Apply(invalid.Field, validation.Present(int64(0)), validation.RuleFunc[int64](func(validation.Input[int64]) []validation.Issue {
		return []validation.Issue{{Code: "association.invalid", Message: "must reference an available resource"}}
	}))
	return httpx.NewHTTPError(http.StatusUnprocessableEntity, "validation failed").WithDetails(details)
}

[[end]]func resourceID(ctx *httpx.Context) (int64, error) {
	id, err := strconv.ParseInt(ctx.Param("id"), 10, 64)
	if err != nil || id < 1 {
		return 0, httpx.NewHTTPError(http.StatusBadRequest, "invalid [[.Package]] ID")
	}
	return id, nil
}
