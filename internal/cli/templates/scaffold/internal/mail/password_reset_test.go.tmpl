package mail

import (
	"strings"
	netmail "net/mail"
	"testing"
	"time"

	views "[[.Module]]/resources/views"
)

func TestPasswordResetBuildsTextAndEscapedHTML(t *testing.T) {
	renderer, err := views.New()
	if err != nil {
		t.Fatal(err)
	}
	mail, err := NewPasswordReset(renderer, "GoForge <no-reply@example.test>")
	if err != nil {
		t.Fatal(err)
	}
	message, err := mail.Message(netmail.Address{Address: "person@example.test"}, "https://example.test/reset-password?token=selector.secret&next=<unsafe>", 30*time.Minute)
	if err != nil {
		t.Fatal(err)
	}
	if !strings.Contains(message.Text(), "selector.secret") || !strings.Contains(message.HTML(), "selector.secret") {
		t.Fatalf("reset URL is absent: text=%q HTML=%q", message.Text(), message.HTML())
	}
	if strings.Contains(message.HTML(), "<unsafe>") || !strings.Contains(message.HTML(), "%3cunsafe%3e") {
		t.Fatalf("HTML reset URL is not contextually escaped: %q", message.HTML())
	}
}
