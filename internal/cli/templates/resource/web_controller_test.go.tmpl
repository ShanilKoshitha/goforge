[[if .AccessibleForms]]func assertAccessibleControl(t *testing.T, body, id, label string, invalid bool) {
	t.Helper()
	if !strings.Contains(body, `<label for="`+id+`">`+label+`</label>`) {
		t.Errorf("control %s has no matching label %q: %s", id, label, body)
	}
	control := accessibleControlTag(t, body, id)
	if !strings.Contains(body, `id="`+id+`-help"`) || !strings.Contains(control, id+`-help`) {
		t.Errorf("control %s is not associated with its stable help text: control=%s body=%s", id, control, body)
	}
	if invalid {
		if !strings.Contains(control, `aria-invalid="true"`) || !strings.Contains(control, id+`-errors`) ||
			!strings.Contains(body, `id="`+id+`-errors"`) {
			t.Errorf("invalid control %s is not associated with one error container: control=%s body=%s", id, control, body)
		}
	} else if strings.Contains(control, "aria-invalid") || strings.Contains(control, id+`-errors`) || strings.Contains(body, `id="`+id+`-errors"`) {
		t.Errorf("valid control %s exposes invalid state: control=%s body=%s", id, control, body)
	}
}

func accessibleControlTag(t *testing.T, body, id string) string {
	t.Helper()
	pattern := regexp.MustCompile(`<(?:input|textarea|select)\b[^>]*\bid="` + regexp.QuoteMeta(id) + `"[^>]*>`)
	control := pattern.FindString(body)
	if control == "" {
		t.Fatalf("control %s has no page-unique id: %s", id, body)
	}
	return control
}

[[end]]func browserRequest(router http.Handler, method, target string, values url.Values, cookie *http.Cookie) *httptest.ResponseRecorder {
	var body *strings.Reader
	if values == nil {
		body = strings.NewReader("")
	} else {
		body = strings.NewReader(values.Encode())
	}
	request := httptest.NewRequest(method, target, body)
	if values != nil {
		request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	}
	if cookie != nil {
		request.AddCookie(cookie)
	}
	response := httptest.NewRecorder()
	router.ServeHTTP(response, request)
	return response
}

func browserCSRFToken(t *testing.T, body string) string {
	t.Helper()
	match := browserCSRFInput.FindStringSubmatch(body)
	if len(match) != 2 {
		t.Fatalf("response has no CSRF field: %s", body)
	}
	return match[1]
}

func browserVersion(t *testing.T, body string) string {
	t.Helper()
	match := browserVersionInput.FindStringSubmatch(body)
	if len(match) != 2 {
		t.Fatalf("response has no version field: %s", body)
	}
	return match[1]
}

func responseCookie(response *httptest.ResponseRecorder, fallback *http.Cookie) *http.Cookie {
	if cookies := response.Result().Cookies(); len(cookies) > 0 {
		return cookies[0]
	}
	return fallback
}
