func repositorySelectedColumns(query string) []string {
	selection, _, found := strings.Cut(query, " FROM ")
	if !found {
		return nil
	}
	selection = strings.TrimPrefix(selection, "SELECT ")
	parts := strings.Split(selection, ", ")
	columns := make([]string, len(parts))
	for index, part := range parts {
		if separator := strings.LastIndexByte(part, '.'); separator >= 0 {
			part = part[separator+1:]
		}
		columns[index] = strings.Trim(part, `"`)
	}
	return columns
}

func repositoryTargetValues(columns []string) []driver.Value {
	values := make([]driver.Value, len(columns))
	for index, column := range columns {
		switch column {
		case "id":
			values[index] = int64(71)
		case "user_id":
			values[index] = int64(9)
		case "created_at", "updated_at":
			values[index] = time.Unix(1, 0)
		case "version":
			values[index] = int64(1)
		default:
			// The bounded resource vocabulary accepts integer 1 for integer,
			// boolean, string, and nullable scan destinations in database/sql.
			values[index] = int64(1)
		}
	}
	return values
}
