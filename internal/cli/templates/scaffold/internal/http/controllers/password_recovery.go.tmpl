package controllers

import (
	"context"
	"errors"
	"net/http"

	"github.com/ShanilKoshitha/goforge/httpx"
	"github.com/ShanilKoshitha/goforge/validation"
	"github.com/ShanilKoshitha/goforge/view"
	"github.com/ShanilKoshitha/goforge/web"

	"[[.Module]]/internal/auth"
	"[[.Module]]/internal/http/requests"
)

const (
	PasswordResetRequestedMessage = "If an account matches that email address, a password reset link will be sent."
	PasswordResetRejectedMessage  = "The password reset link is invalid or has expired."
	PasswordResetCompletedMessage = "Your password has been reset. Sign in with your new password."
)

type PasswordRecoveryService interface {
	Request(context.Context, string) error
	Reset(context.Context, string, string) error
}

type PasswordRecoveryPage struct {
	Title  string
	Notice string
	Error  string
	Token  string
	Form   view.Form
}

type PasswordRecoveryController struct {
	recovery PasswordRecoveryService
	views    web.Renderer
}

func NewPasswordRecoveryController(recovery PasswordRecoveryService, views web.Renderer) *PasswordRecoveryController {
	return &PasswordRecoveryController{recovery: recovery, views: views}
}

func (controller *PasswordRecoveryController) ForgotForm(ctx *httpx.Context) error {
	passwordRecoveryHeaders(ctx)
	current, ok := web.Session(ctx)
	if !ok {
		return errors.New("browser session is unavailable")
	}
	var notice string
	if _, err := current.Get("notice", &notice); err != nil {
		return err
	}
	return controller.renderForgot(ctx, http.StatusOK, PasswordRecoveryPage{
		Title: "Forgot password", Notice: notice,
	})
}

func (controller *PasswordRecoveryController) Forgot(ctx *httpx.Context) error {
	passwordRecoveryHeaders(ctx)
	var request requests.ForgotPasswordRequest
	if err := request.DecodeForm(ctx); err != nil {
		return err
	}
	page := PasswordRecoveryPage{
		Title: "Forgot password",
		Form:  view.Form{OldValues: map[string]string{"email": request.Email}},
	}
	if problems := request.Validate(); !problems.Empty() {
		page.Form.ValidationErrors = problems.Messages()
		return controller.renderForgot(ctx, http.StatusUnprocessableEntity, page)
	}
	if err := controller.recovery.Request(ctx.Request.Context(), request.Email); err != nil {
		return err
	}
	current, ok := web.Session(ctx)
	if !ok {
		return errors.New("browser session is unavailable")
	}
	if err := current.Flash("notice", PasswordResetRequestedMessage); err != nil {
		return err
	}
	return web.Redirect(ctx, "/forgot-password")
}

func (controller *PasswordRecoveryController) ResetForm(ctx *httpx.Context) error {
	passwordRecoveryHeaders(ctx)
	return controller.renderReset(ctx, http.StatusOK, PasswordRecoveryPage{
		Title: "Reset password", Token: ctx.Query("token"),
	})
}

func (controller *PasswordRecoveryController) Reset(ctx *httpx.Context) error {
	passwordRecoveryHeaders(ctx)
	var request requests.ResetPasswordRequest
	if err := request.DecodeForm(ctx); err != nil {
		return err
	}
	page := PasswordRecoveryPage{Title: "Reset password", Token: request.Token}
	if problems := request.Validate(); !problems.Empty() {
		page.Form.ValidationErrors = problems.Messages()
		return controller.renderReset(ctx, http.StatusUnprocessableEntity, page)
	}
	if err := controller.recovery.Reset(ctx.Request.Context(), request.Token, request.Password); err != nil {
		if errors.Is(err, auth.ErrInvalidPasswordReset) {
			page.Error = PasswordResetRejectedMessage
			return controller.renderReset(ctx, http.StatusUnprocessableEntity, page)
		}
		return err
	}
	current, ok := web.Session(ctx)
	if !ok {
		return errors.New("browser session is unavailable")
	}
	if err := current.Flash("notice", PasswordResetCompletedMessage); err != nil {
		return err
	}
	return web.Redirect(ctx, "/login")
}

func (controller *PasswordRecoveryController) ForgotJSON(ctx *httpx.Context) error {
	passwordRecoveryHeaders(ctx)
	var request requests.ForgotPasswordRequest
	if err := request.DecodeJSON(ctx); err != nil {
		return err
	}
	if problems := request.Validate(); !problems.Empty() {
		return httpx.NewHTTPError(http.StatusUnprocessableEntity, "validation failed").WithDetails(problems)
	}
	if err := controller.recovery.Request(ctx.Request.Context(), request.Email); err != nil {
		return err
	}
	return ctx.JSON(http.StatusAccepted, struct {
		Message string `json:"message"`
	}{Message: PasswordResetRequestedMessage})
}

func (controller *PasswordRecoveryController) ResetJSON(ctx *httpx.Context) error {
	passwordRecoveryHeaders(ctx)
	var request requests.ResetPasswordRequest
	if err := request.DecodeJSON(ctx); err != nil {
		return err
	}
	if problems := request.Validate(); !problems.Empty() {
		return httpx.NewHTTPError(http.StatusUnprocessableEntity, "validation failed").WithDetails(problems)
	}
	if err := controller.recovery.Reset(ctx.Request.Context(), request.Token, request.Password); err != nil {
		if errors.Is(err, auth.ErrInvalidPasswordReset) {
			return httpx.NewHTTPError(http.StatusUnprocessableEntity, PasswordResetRejectedMessage)
		}
		return err
	}
	return ctx.NoContent(http.StatusNoContent)
}

func (controller *PasswordRecoveryController) renderForgot(ctx *httpx.Context, status int, page PasswordRecoveryPage) error {
	return controller.render(ctx, status, "auth/forgot_password", page)
}

func (controller *PasswordRecoveryController) renderReset(ctx *httpx.Context, status int, page PasswordRecoveryPage) error {
	return controller.render(ctx, status, "auth/reset_password", page)
}

func (controller *PasswordRecoveryController) render(ctx *httpx.Context, status int, name string, page PasswordRecoveryPage) error {
	token, err := web.CSRFToken(ctx)
	if err != nil {
		return err
	}
	page.Form.CSRFToken = token
	if page.Form.ValidationErrors == nil {
		page.Form.ValidationErrors = make(validation.Errors)
	}
	if page.Form.OldValues == nil {
		page.Form.OldValues = make(map[string]string)
	}
	return web.Render(ctx, controller.views, status, name, page)
}

func passwordRecoveryHeaders(ctx *httpx.Context) {
	ctx.Response.Header().Set("Cache-Control", "no-store")
	ctx.Response.Header().Set("Referrer-Policy", "no-referrer")
	ctx.Response.Header().Set("X-Robots-Tag", "noindex")
}
