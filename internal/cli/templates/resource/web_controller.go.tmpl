func (controller *WebController) Index(ctx *httpx.Context) error {
	user, err := webUser(ctx)
	if err != nil {
		return err
	}
[[if .AuthorizationPolicies]]	scope, err := requestAuthorizationScope(ctx, user, ActionList, controller.authorize)
	if err != nil {
		return err
	}
[[end]]	pageNumber, pageSize, err := paginationParameters(ctx)
	if err != nil {
		return err
	}
	page, err := controller.repository.Paginate(ctx.Request.Context(), [[if .AuthorizationPolicies]]scope[[else]]user.ID[[end]], pageNumber, pageSize)
	if err != nil {
		return err
	}
	token, notice, err := browserState(ctx)
	if err != nil {
		return err
	}
	items := make([]ItemView, len(page.Items))
	for index, item := range page.Items {
		items[index] = presentItem(item)
	}
	return web.Render(ctx, controller.views, http.StatusOK, "pages/[[.Plural]]/index", IndexPage{
		Title: "[[.Name]]s", Form: view.Form{CSRFToken: token}, Notice: notice, Items: items,
		Page: page.Number, PerPage: page.PerPage,
		PreviousURL: paginationURL(page.Number-1, page.PerPage, page.HasPrevious),
		NextURL: paginationURL(page.Number+1, page.PerPage, page.HasNext),
	})
}

