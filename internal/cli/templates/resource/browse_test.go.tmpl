func TestChoiceOptionsAndLabels(t *testing.T) {
	for _, options := range []ChoiceOptions{{Search: "x", ID: 1}, {ID: -1}, {SelectedID: -1}, {Page: -1}, {Page: 10001}, {Search: string([]byte{0xff})}, {Search: "\x00"}, {Search: strings.Repeat("界", 201)}} {
		if err := options.Validate(true); err == nil { t.Fatalf("invalid choice accepted: %#v", options) }
	}
	if err := (ChoiceOptions{Search: "private"}).Validate(false); err == nil { t.Fatal("undeclared choice text search accepted") }
	if err := (ChoiceOptions{Search: strings.Repeat("界", 200)}).Validate(true); err != nil { t.Fatal(err) }
	label := associationChoiceLabel("Target", 71, strings.Repeat("界", 121))
	text := strings.TrimSuffix(label, " (Target #71)")
	if utf8.RuneCountInString(text) != 120 || !utf8.ValidString(label) { t.Fatalf("label truncation = %q", label) }
	if got := associationChoiceLabel("Target", 71, ""); got != "Target #71" { t.Fatalf("ID label = %q", got) }
	if got := associationChoiceLabel("Target", 71, "<script>&"); got != "<script>& (Target #71)" { t.Fatalf("label was escaped before rendering: %q", got) }
[[range .Relationships]]	{
		item := models.[[.TargetSpec.Name]]{ID: 71}
		if choice := [[.Name]]AssociationChoice(item); choice.Label != "[[.TargetSpec.Name]] #71" { t.Fatalf("[[.GoName]] empty/null label did not fall back to ID: %#v", choice) }
[[if .ChoiceLabelGoName]]		text := strings.Repeat("界", 121)
		item.[[.ChoiceLabelGoName]] = [[if .ChoiceLabelNullable]]&text[[else]]text[[end]]
		if choice := [[.Name]]AssociationChoice(item); choice.Label != strings.Repeat("界", 120)+" ([[.TargetSpec.Name]] #71)" { t.Fatalf("[[.GoName]] label did not use only declared/truncated text: %#v", choice) }
[[end]]	}
[[end]]
}

func TestChoicePagesBoundedSelectedRetentionAndPrivacyInDBAndTx(t *testing.T) {
	registerRepositoryDriver.Do(func() { sql.Register("goforge-generated-repository", repositoryDriver{}) })
	db, err := sql.Open("goforge-generated-repository", "")
	if err != nil { t.Fatal(err) }
	defer db.Close()
	check := func(t *testing.T, executor orm.Executor) {
		repository := NewPostgresRepository(executor)
		connection := repositoryConnectionFrom(t, executor)
[[range .Relationships]]		{
			connection.targetQuery = func(query string, _ []driver.NamedValue) (driver.Rows, error) {
				columns := repositorySelectedColumns(query)
				values := repositoryTargetValues(columns)
				count := associationChoicePageSize+1
				if strings.Contains(query, `."id" =`) && !strings.Contains(query, " OFFSET ") { count = 1; for index, column := range columns { if column == "id" { values[index] = int64(99) } } }
				return &repositoryRows{columns: columns, values: values, remaining: count}, nil
			}
			connection.resetStatements()
			options := ChoiceOptions{Page: 2, SelectedID: 99}
			page, err := repository.[[.GoName]]Choices(context.Background(), 9, options)
			if err != nil || len(page.Items) != associationChoicePageSize || !page.HasNext || !page.HasPrevious || page.Number != 2 || page.Selected == nil || page.Selected.ID != 99 { t.Fatalf("[[.GoName]] retained page = %#v, %v", page, err) }
			if page.Items[0].Label != "[[if .ChoiceLabelGoName]]1 ([[end]][[.TargetSpec.Name]] #71[[if .ChoiceLabelGoName]])[[end]]" { t.Fatalf("[[.GoName]] disclosed the wrong label: %q", page.Items[0].Label) }
			if len(connection.queries) != 2 || !strings.Contains(connection.queries[0], `"[[.TargetSpec.Plural]]"."user_id" = $1`) || !strings.Contains(connection.queries[1], `"[[.TargetSpec.Plural]]"."user_id" = $1 AND "[[.TargetSpec.Plural]]"."id" = $2`) { t.Fatalf("[[.GoName]] selection lost owner scope: %#v", connection.queries) }
			assertBrowseArguments(t, connection.queryArgs[0], []any{int64(9), int64(21), int64(20)})
			assertBrowseArguments(t, connection.queryArgs[1], []any{int64(9), int64(99), int64(1)})
			options.SelectedID = 71
			connection.resetStatements()
			page, err = repository.[[.GoName]]Choices(context.Background(), 9, options)
			if err != nil || page.Selected == nil || page.Selected.ID != 71 || len(connection.queries) != 1 { t.Fatalf("[[.GoName]] in-page selection used extra queries: %#v %v %#v", page, err, connection.queries) }
			options.SelectedID = 99
			options.ID = 71
			connection.resetStatements()
			page, err = repository.[[.GoName]]Choices(context.Background(), 9, options)
			if err != nil || page.Selected == nil || page.Selected.ID != 99 || len(connection.queries) != 2 { t.Fatalf("[[.GoName]] ID filter hid independent selection: %#v %v", page, err) }
			assertBrowseArguments(t, connection.queryArgs[0], []any{int64(9), int64(71), int64(21), int64(20)})
			assertBrowseArguments(t, connection.queryArgs[1], []any{int64(9), int64(99), int64(1)})
			options.ID = 0
			connection.targetQuery = func(query string, _ []driver.NamedValue) (driver.Rows, error) { return &repositoryRows{columns: repositorySelectedColumns(query)}, nil }
			connection.resetStatements()
			page, err = repository.[[.GoName]]Choices(context.Background(), 9, options)
			if err != nil || page.Selected != nil || len(page.Items) != 0 || page.HasNext { t.Fatalf("[[.GoName]] missing/foreign selection disclosed: %#v %v", page, err) }
			connection.resetStatements()
			if _, err := repository.[[.GoName]]Choices(context.Background(), 0, options); err == nil || len(connection.queries) != 0 { t.Fatal("invalid choice owner reached DB") }
[[if .ChoiceLabelGoName]]			connection.targetQuery = nil
			connection.targetRowCount = 1
			options = ChoiceOptions{Search: "%_!\\", Page: 1}
			connection.resetStatements()
			if _, err := repository.[[.GoName]]Choices(context.Background(), 9, options); err != nil { t.Fatal(err) }
			if !strings.Contains(connection.queries[0], `"[[.TargetSpec.Plural]]"."[[.ChoiceLabelName]]" ILIKE $2 ESCAPE '!'`) { t.Fatalf("declared choice search missing: %s", connection.queries[0]) }
			assertBrowseArguments(t, connection.queryArgs[0], []any{int64(9), "%!%!_!!\\%", int64(21), int64(0)})
[[else]]			if _, err := repository.[[.GoName]]Choices(context.Background(), 9, ChoiceOptions{Search: "private"}); err == nil || len(connection.queries) != 0 { t.Fatal("undeclared choice text reached DB") }
[[end]]			connection.targetQuery = nil
		}
[[end]]	}
	t.Run("db", func(t *testing.T) { check(t, db) })
	tx, err := db.Begin()
	if err != nil { t.Fatal(err) }
	defer tx.Rollback()
	t.Run("tx", func(t *testing.T) { check(t, tx) })
}
