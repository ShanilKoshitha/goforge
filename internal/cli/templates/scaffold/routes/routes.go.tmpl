package routes

import (
	"context"
	"database/sql"
	"errors"
	"time"

	"github.com/ShanilKoshitha/goforge/httpx"
	"github.com/ShanilKoshitha/goforge/security/password"
	"github.com/ShanilKoshitha/goforge/security/ratelimit"
	"github.com/ShanilKoshitha/goforge/session"
	"github.com/ShanilKoshitha/goforge/view"
	"github.com/ShanilKoshitha/goforge/web"

	"[[.Module]]/database/migrations"
	"[[.Module]]/internal/auth"
	"[[.Module]]/internal/config"
	"[[.Module]]/internal/http/controllers"
	"[[.Module]]/internal/jobs"
	appmail "[[.Module]]/internal/mail"
	"[[.Module]]/internal/mailbox"
)

func Register(router *httpx.Router, renderer *view.Engine, db *sql.DB, sessions session.Store, attemptStore ratelimit.Store, settings config.Config, recovery controllers.PasswordRecoveryService, registrations ...auth.RegistrationTransaction) error {
	manager, err := session.NewManagerWithPolicy(sessions, []byte(settings.SessionSecret), session.Cookie{
		UnsafeAllowHTTP: settings.Environment == "local",
	}, session.Policy{
		IdleLifetime: settings.SessionIdleLifetime, AbsoluteLifetime: settings.SessionAbsoluteLifetime,
	})
	if err != nil {
		return err
	}
	trustedProxies, err := ratelimit.ParseTrustedProxies(settings.TrustedProxies)
	if err != nil {
		return err
	}
	sourceAttempts, err := ratelimit.New(attemptStore, ratelimit.Policy{Limit: 20, Window: time.Minute})
	if err != nil {
		return err
	}
	accountAttempts, err := ratelimit.New(attemptStore, ratelimit.Policy{Limit: 8, Window: 15 * time.Minute})
	if err != nil {
		return err
	}
	recoverySourceAttempts, err := ratelimit.New(attemptStore, ratelimit.Policy{Limit: 10, Window: 15 * time.Minute})
	if err != nil {
		return err
	}
	recoveryAccountAttempts, err := ratelimit.New(attemptStore, ratelimit.Policy{Limit: 3, Window: time.Hour})
	if err != nil {
		return err
	}
	sourceKey := func(action string) ratelimit.KeyFunc {
		return func(ctx *httpx.Context) string {
			return ratelimit.Key("auth-source", action, trustedProxies.ClientAddress(ctx.Request))
		}
	}
	limitRegister := ratelimit.Middleware(sourceAttempts, sourceKey("register"))
	limitLogin := ratelimit.Middleware(sourceAttempts, sourceKey("login"))
	limitRecoveryRequest := ratelimit.Middleware(recoverySourceAttempts, sourceKey("password-recovery-request"))
	limitRecoveryReset := ratelimit.Middleware(recoverySourceAttempts, sourceKey("password-recovery-reset"))

	users := auth.NewPostgresUserRepository(db)
	authController := auth.NewController(users, manager, password.New(), accountAttempts, registrations...)
	webAuthController := auth.NewWebController(authController, renderer)
	if recovery == nil {
		if db == nil && settings.Environment == "test" {
			recovery = unavailablePasswordRecovery{}
		} else {
			recovery, err = defaultPasswordRecovery(db, renderer, recoveryAccountAttempts, settings)
			if err != nil {
				return err
			}
		}
	}
	recoveryController := controllers.NewPasswordRecoveryController(recovery, renderer)
	requireAuth := auth.Require(manager, users)
	requireWebAuth := auth.RequireWeb(users)

	health := controllers.NewHealthController(db, migrations.Files)
	welcome := controllers.NewWelcomeController(renderer)
	router.Named("welcome", "GET", "/", welcome.Show)
	router.Named("health.show", "GET", "/health", health.Show)
	router.Named("health.ready", "GET", "/ready", health.Ready)
	router.Named("auth.register", "POST", "/auth/register", limitRegister(authController.Register))
	router.Named("auth.login", "POST", "/auth/login", limitLogin(authController.Login))
	router.Named("auth.password.forgot", "POST", "/auth/password/forgot", limitRecoveryRequest(recoveryController.ForgotJSON))
	router.Named("auth.password.reset", "POST", "/auth/password/reset", limitRecoveryReset(recoveryController.ResetJSON))
	authenticated := router.Group("", requireAuth)
	authenticated.GET("/auth/me", authController.Me)
	authenticated.POST("/auth/logout", authController.Logout)
	authenticated.PUT("/auth/password", authController.ChangePassword)
	authenticated.POST("/auth/logout-all", authController.RevokeAll)
	browser := router.Group("", web.Sessions(manager), web.CSRF())
	browser.Named("web.auth.register.form", "GET", "/register", webAuthController.RegisterForm)
	browser.Named("web.auth.login.form", "GET", "/login", webAuthController.LoginForm)
	browser.Named("web.auth.password.forgot.form", "GET", "/forgot-password", recoveryController.ForgotForm)
	browser.Named("web.auth.password.reset.form", "GET", "/reset-password", recoveryController.ResetForm)
	router.Named("web.auth.register", "POST", "/register",
		limitRegister(web.Sessions(manager)(web.CSRF()(webAuthController.Register))))
	router.Named("web.auth.login", "POST", "/login",
		limitLogin(web.Sessions(manager)(web.CSRF()(webAuthController.Login))))
	router.Named("web.auth.password.forgot", "POST", "/forgot-password",
		limitRecoveryRequest(web.Sessions(manager)(web.CSRF()(recoveryController.Forgot))))
	router.Named("web.auth.password.reset", "POST", "/reset-password",
		limitRecoveryReset(web.Sessions(manager)(web.CSRF()(recoveryController.Reset))))
	authenticatedBrowser := router.Group("", web.Sessions(manager), requireWebAuth, web.CSRF())
	authenticatedBrowser.Named("web.dashboard", "GET", "/app", webAuthController.Dashboard)
	authenticatedBrowser.Named("web.auth.logout", "POST", "/logout", webAuthController.Logout)
	authenticatedBrowser.Named("web.auth.security", "GET", "/settings/security", webAuthController.Security)
	authenticatedBrowser.Named("web.auth.password", "POST", "/settings/password", webAuthController.ChangePassword)
	authenticatedBrowser.Named("web.auth.logout_all", "POST", "/settings/logout-all", webAuthController.RevokeAll)
	registerResources(router, renderer, db, manager, requireAuth, requireWebAuth)
	return nil
}

func defaultPasswordRecovery(db *sql.DB, renderer *view.Engine, attempts *ratelimit.Limiter, settings config.Config) (controllers.PasswordRecoveryService, error) {
	if db == nil {
		return nil, errors.New("password recovery database is required")
	}
	outbox, err := mailbox.New(settings.MailOutboxKey)
	if err != nil {
		return nil, err
	}
	dispatcher, err := jobs.NewDispatcher(db, nil)
	if err != nil {
		return nil, err
	}
	delivery, err := auth.NewPostgresPasswordRecoveryDelivery(outbox, dispatcher)
	if err != nil {
		return nil, err
	}
	mailer, err := appmail.NewPasswordReset(renderer, settings.MailFrom)
	if err != nil {
		return nil, err
	}
	return auth.NewPasswordRecovery(
		db, password.New(), attempts, mailer, delivery,
		settings.ApplicationURL, settings.PasswordResetTTL,
	)
}

type unavailablePasswordRecovery struct{}

func (unavailablePasswordRecovery) Request(context.Context, string) error {
	return errors.New("password recovery is unavailable")
}

func (unavailablePasswordRecovery) Reset(context.Context, string, string) error {
	return errors.New("password recovery is unavailable")
}
