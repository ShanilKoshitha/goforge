@extends("layouts/app")
@section("title"){{.Title}}@endsection
@section("content")
  @component("components/card", title=.Title, tone="auth")
    @if(.Notice)<p role="status">{{.Notice}}</p>@endif
    <p>Enter your email address and we will send password reset instructions if the account exists.</p>
    <form action="/forgot-password" method="post">
      @csrf
      <label>Email
        <input type="email" name="email" value="@old("email", "")" autocomplete="email" required>
      </label>
      @errors("email")<p role="alert">{{.}}</p>@enderrors
      <button type="submit">Send reset instructions</button>
    </form>
    @slot("actions")<a href="/login">Back to sign in</a>@endslot
  @endcomponent
@endsection
