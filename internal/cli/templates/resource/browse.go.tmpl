const associationChoicePageSize = 20

type ChoiceOptions struct {
	Search string
	ID int64
	Page int
	SelectedID int64
}

func DefaultChoiceOptions() ChoiceOptions { return ChoiceOptions{Page: 1} }

func (options ChoiceOptions) normalized() ChoiceOptions {
	if options.Page == 0 { options.Page = 1 }
	return options
}

func (options ChoiceOptions) Validate(searchable bool) error {
	options = options.normalized()
	if err := validateSearch(options.Search, searchable); err != nil { return err }
	if options.ID < 0 || options.SelectedID < 0 { return browseInputError("choice IDs must be positive when provided") }
	if options.ID > 0 && options.Search != "" { return browseInputError("choice text and ID filters cannot be combined") }
	if options.Page < 1 || options.Page > maximumPageNumber { return browseInputError("choice page must be between 1 and 10000") }
	return nil
}

type AssociationChoicePage struct {
	Items []AssociationChoice
	Selected *AssociationChoice
	Number int
	HasPrevious bool
	HasNext bool
}

func associationChoiceLabel(name string, id int64, text string) string {
	identity := fmt.Sprintf("%s #%d", name, id)
	text = strings.TrimSpace(text)
	characters := []rune(text)
	if len(characters) > 120 { text = string(characters[:120]) }
	if text == "" { return identity }
	return text + " (" + identity + ")"
}

[[range .Relationships]]func [[.Name]]AssociationChoice(item models.[[.TargetSpec.Name]]) AssociationChoice {
	text := ""
[[if .ChoiceLabelGoName]][[if .ChoiceLabelNullable]]	if item.[[.ChoiceLabelGoName]] != nil { text = string(*item.[[.ChoiceLabelGoName]]) }
[[else]]	text = string(item.[[.ChoiceLabelGoName]])
[[end]][[end]]	return AssociationChoice{ID: item.ID, Label: associationChoiceLabel("[[.TargetSpec.Name]]", item.ID, text)}
}

func (repository *PostgresRepository) [[.GoName]]Choices(ctx context.Context, userID int64, options ChoiceOptions) (AssociationChoicePage, error) {
	if userID < 1 { return AssociationChoicePage{}, fmt.Errorf("choice owner must be positive") }
	options = options.normalized()
	if err := options.Validate([[if .ChoiceLabelGoName]]true[[else]]false[[end]]); err != nil { return AssociationChoicePage{}, err }
	predicates := []orm.Predicate[models.[[.TargetSpec.Name]]]{models.[[.TargetSpec.Name]]Columns.UserID.Eq(userID)}
	if options.ID > 0 { predicates = append(predicates, models.[[.TargetSpec.Name]]Columns.ID.Eq(options.ID)) }
[[if .ChoiceLabelGoName]]	if options.Search != "" { predicates = append(predicates, orm.[[if .ChoiceLabelNullable]]ContainsFoldNullable[[else]]ContainsFold[[end]](models.[[.TargetSpec.Name]]Columns.[[.ChoiceLabelGoName]], options.Search)) }
[[end]]	query := models.NewStore(repository.Executor).[[.TargetQueryAccessor]]()
	items, err := query.Select().Where(predicates...).OrderBy(models.[[.TargetSpec.Name]]Columns.ID.Asc()).
		Limit(associationChoicePageSize + 1).Offset((options.Page - 1) * associationChoicePageSize).All(ctx, repository.Executor)
	if err != nil { return AssociationChoicePage{}, fmt.Errorf("list [[.ForeignKey]] choices: %w", postgres.Classify(err)) }
	page := AssociationChoicePage{Items: make([]AssociationChoice, 0, associationChoicePageSize), Number: options.Page, HasPrevious: options.Page > 1, HasNext: len(items) > associationChoicePageSize}
	if page.HasNext { items = items[:associationChoicePageSize] }
	for _, item := range items {
		choice := [[.Name]]AssociationChoice(item)
		page.Items = append(page.Items, choice)
		if item.ID == options.SelectedID { selected := choice; page.Selected = &selected }
	}
	if options.SelectedID > 0 && page.Selected == nil {
		selected, err := query.Select().Where(models.[[.TargetSpec.Name]]Columns.UserID.Eq(userID), models.[[.TargetSpec.Name]]Columns.ID.Eq(options.SelectedID)).First(ctx, repository.Executor)
		if err != nil && !errors.Is(err, orm.ErrNotFound) { return AssociationChoicePage{}, fmt.Errorf("selected [[.ForeignKey]] choice: %w", postgres.Classify(err)) }
		if err == nil { choice := [[.Name]]AssociationChoice(selected); page.Selected = &choice }
	}
	return page, nil
}

