package config

import (
	"encoding/base64"
	"errors"
	"fmt"
	"net"
	"net/mail"
	"net/url"
	"strings"
	"time"

	forgeconfig "github.com/ShanilKoshitha/goforge/config"
)

type Config struct {
	Environment             string
	Address                 string
	ShutdownTimeout         time.Duration
	RequestTimeout          time.Duration
	ReadHeaderTimeout       time.Duration
	ReadTimeout             time.Duration
	WriteTimeout            time.Duration
	IdleTimeout             time.Duration
	MaxHeaderBytes          int
	EnableHSTS              bool
	TrustedProxies          string
	DatabaseURL             string
	SessionSecret           string
	SessionIdleLifetime     time.Duration
	SessionAbsoluteLifetime time.Duration
	ApplicationURL          string
	PasswordResetTTL        time.Duration
	MailFrom                string
	MailOutboxKey           []byte
}

func Load() (Config, error) {
	environment, err := reader()
	if err != nil {
		return Config{}, err
	}
	settings := Config{
		Environment:             environment.String("APP_ENV", "production"),
		Address:                 environment.String("APP_ADDRESS", ":8080"),
		ShutdownTimeout:         environment.Duration("APP_SHUTDOWN_TIMEOUT", 10*time.Second),
		RequestTimeout:          environment.Duration("APP_REQUEST_TIMEOUT", 15*time.Second),
		ReadHeaderTimeout:       environment.Duration("APP_READ_HEADER_TIMEOUT", 5*time.Second),
		ReadTimeout:             environment.Duration("APP_READ_TIMEOUT", 30*time.Second),
		WriteTimeout:            environment.Duration("APP_WRITE_TIMEOUT", 30*time.Second),
		IdleTimeout:             environment.Duration("APP_IDLE_TIMEOUT", 2*time.Minute),
		MaxHeaderBytes:          environment.Int("APP_MAX_HEADER_BYTES", 1<<20),
		EnableHSTS:              environment.Bool("APP_ENABLE_HSTS", false),
		TrustedProxies:          environment.String("TRUSTED_PROXIES", ""),
		DatabaseURL:             environment.Required("DATABASE_URL"),
		SessionSecret:           environment.Required("SESSION_SECRET"),
		SessionIdleLifetime:     environment.Duration("SESSION_IDLE_LIFETIME", 2*time.Hour),
		SessionAbsoluteLifetime: environment.Duration("SESSION_ABSOLUTE_LIFETIME", 24*time.Hour),
		ApplicationURL:          environment.Required("APP_URL"),
		PasswordResetTTL:        environment.Duration("AUTH_PASSWORD_RESET_TTL", 30*time.Minute),
		MailFrom:                environment.Required("MAIL_FROM"),
	}
	settings.MailOutboxKey, err = decodeOutboxKey(environment.Required("MAIL_OUTBOX_KEY"))
	return settings, errors.Join(environment.Err(), err, settings.validate())
}

func (settings Config) validate() error {
	var problems []error
	for _, value := range []struct {
		name     string
		duration time.Duration
	}{
		{"APP_SHUTDOWN_TIMEOUT", settings.ShutdownTimeout},
		{"APP_REQUEST_TIMEOUT", settings.RequestTimeout},
		{"APP_READ_HEADER_TIMEOUT", settings.ReadHeaderTimeout},
		{"APP_READ_TIMEOUT", settings.ReadTimeout},
		{"APP_WRITE_TIMEOUT", settings.WriteTimeout},
		{"APP_IDLE_TIMEOUT", settings.IdleTimeout},
	} {
		if value.duration <= 0 {
			problems = append(problems, fmt.Errorf("%s must be positive", value.name))
		}
	}
	if settings.RequestTimeout > 0 && settings.WriteTimeout > 0 && settings.RequestTimeout >= settings.WriteTimeout {
		problems = append(problems, errors.New("APP_REQUEST_TIMEOUT must be shorter than APP_WRITE_TIMEOUT"))
	}
	if settings.ReadHeaderTimeout > 0 && settings.ReadTimeout > 0 && settings.ReadHeaderTimeout > settings.ReadTimeout {
		problems = append(problems, errors.New("APP_READ_HEADER_TIMEOUT cannot exceed APP_READ_TIMEOUT"))
	}
	if settings.MaxHeaderBytes < 1024 || settings.MaxHeaderBytes > 16<<20 {
		problems = append(problems, errors.New("APP_MAX_HEADER_BYTES must be between 1024 and 16777216"))
	}
	if settings.SessionIdleLifetime <= 0 {
		problems = append(problems, errors.New("SESSION_IDLE_LIFETIME must be positive"))
	}
	if settings.SessionAbsoluteLifetime <= 0 {
		problems = append(problems, errors.New("SESSION_ABSOLUTE_LIFETIME must be positive"))
	}
	if settings.SessionIdleLifetime > 0 && settings.SessionAbsoluteLifetime > 0 && settings.SessionAbsoluteLifetime < settings.SessionIdleLifetime {
		problems = append(problems, errors.New("SESSION_ABSOLUTE_LIFETIME cannot be shorter than SESSION_IDLE_LIFETIME"))
	}
	if err := validateApplicationURL(settings.ApplicationURL, settings.Environment); err != nil {
		problems = append(problems, err)
	}
	if settings.PasswordResetTTL < 5*time.Minute || settings.PasswordResetTTL > 24*time.Hour {
		problems = append(problems, errors.New("AUTH_PASSWORD_RESET_TTL must be between 5m and 24h"))
	}
	if _, err := mail.ParseAddress(settings.MailFrom); err != nil {
		problems = append(problems, errors.New("MAIL_FROM must be one valid mailbox"))
	}
	return errors.Join(problems...)
}

func validateApplicationURL(value, environment string) error {
	parsed, err := url.Parse(value)
	if err != nil || parsed.Hostname() == "" || (parsed.Scheme != "http" && parsed.Scheme != "https") ||
		parsed.User != nil || parsed.RawQuery != "" || parsed.Fragment != "" || (parsed.Path != "" && parsed.Path != "/") {
		return errors.New("APP_URL must be an absolute HTTP(S) origin without credentials, path, query, or fragment")
	}
	if parsed.Scheme != "https" && environment != "local" {
		return errors.New("APP_URL must use HTTPS outside local development")
	}
	return nil
}

type DatabaseConfig struct {
	DatabaseURL string
}

// LoadDatabase reads only settings required by database console commands.
func LoadDatabase() (DatabaseConfig, error) {
	environment, err := reader()
	if err != nil {
		return DatabaseConfig{}, err
	}
	settings := DatabaseConfig{DatabaseURL: environment.Required("DATABASE_URL")}
	return settings, environment.Err()
}

type SchedulerConfig struct {
	DatabaseURL              string
	SchedulePollInterval     time.Duration
	ScheduleOperationTimeout time.Duration
}

// LoadScheduler reads only settings required by the recurring scheduler.
func LoadScheduler() (SchedulerConfig, error) {
	environment, err := reader()
	if err != nil {
		return SchedulerConfig{}, err
	}
	settings := SchedulerConfig{
		DatabaseURL:              environment.Required("DATABASE_URL"),
		SchedulePollInterval:     environment.Duration("SCHEDULE_POLL_INTERVAL", 15*time.Second),
		ScheduleOperationTimeout: environment.Duration("SCHEDULE_OP_TIMEOUT", 5*time.Second),
	}
	return settings, errors.Join(environment.Err(), settings.validate())
}

func (settings SchedulerConfig) validate() error {
	var problems []error
	if settings.SchedulePollInterval < time.Second || settings.SchedulePollInterval > time.Minute {
		problems = append(problems, errors.New("SCHEDULE_POLL_INTERVAL must be between 1s and 1m"))
	}
	if settings.ScheduleOperationTimeout < 100*time.Millisecond || settings.ScheduleOperationTimeout > time.Minute {
		problems = append(problems, errors.New("SCHEDULE_OP_TIMEOUT must be between 100ms and 1m"))
	}
	return errors.Join(problems...)
}

type WorkerConfig struct {
	Environment            string
	DatabaseURL            string
	JobQueues              string
	JobConcurrency         int
	JobPollInterval        time.Duration
	JobLeaseDuration       time.Duration
	JobHeartbeatInterval   time.Duration
	JobOperationTimeout    time.Duration
	JobCancellationTimeout time.Duration
	JobShutdownTimeout     time.Duration
	MailSMTPAddress        string
	MailSMTPUsername       string
	MailSMTPPassword       string
	MailSMTPTLS            string
	MailSMTPServerName     string
	MailSMTPTimeout        time.Duration
	MailOutboxKey          []byte
}

// LoadWorker reads only settings required by the background worker.
func LoadWorker() (WorkerConfig, error) {
	environment, err := reader()
	if err != nil {
		return WorkerConfig{}, err
	}
	settings := WorkerConfig{
		Environment:            environment.String("APP_ENV", "production"),
		DatabaseURL:            environment.Required("DATABASE_URL"),
		JobQueues:              environment.String("JOB_QUEUES", "default"),
		JobConcurrency:         environment.Int("JOB_CONCURRENCY", 4),
		JobPollInterval:        environment.Duration("JOB_POLL_INTERVAL", time.Second),
		JobLeaseDuration:       environment.Duration("JOB_LEASE_DURATION", 30*time.Second),
		JobHeartbeatInterval:   environment.Duration("JOB_HEARTBEAT_INTERVAL", 10*time.Second),
		JobOperationTimeout:    environment.Duration("JOB_OPERATION_TIMEOUT", 5*time.Second),
		JobCancellationTimeout: environment.Duration("JOB_CANCELLATION_TIMEOUT", 5*time.Second),
		JobShutdownTimeout:     environment.Duration("JOB_SHUTDOWN_TIMEOUT", 15*time.Second),
		MailSMTPAddress:        environment.Required("MAIL_SMTP_ADDRESS"),
		MailSMTPUsername:       environment.String("MAIL_SMTP_USERNAME", ""),
		MailSMTPPassword:       environment.String("MAIL_SMTP_PASSWORD", ""),
		MailSMTPTLS:            environment.String("MAIL_SMTP_TLS", "starttls"),
		MailSMTPServerName:     environment.String("MAIL_SMTP_SERVER_NAME", ""),
		MailSMTPTimeout:        environment.Duration("MAIL_SMTP_TIMEOUT", 10*time.Second),
	}
	settings.MailOutboxKey, err = decodeOutboxKey(environment.Required("MAIL_OUTBOX_KEY"))
	return settings, errors.Join(environment.Err(), err, settings.validate())
}

func (settings WorkerConfig) validate() error {
	var problems []error
	host, port, err := net.SplitHostPort(settings.MailSMTPAddress)
	if err != nil || host == "" || port == "" {
		problems = append(problems, errors.New("MAIL_SMTP_ADDRESS must contain a host and port"))
	}
	if (settings.MailSMTPUsername == "") != (settings.MailSMTPPassword == "") {
		problems = append(problems, errors.New("MAIL_SMTP_USERNAME and MAIL_SMTP_PASSWORD must be set together"))
	}
	switch settings.MailSMTPTLS {
	case "starttls", "implicit":
		if !validServerName(settings.MailSMTPServerName) {
			problems = append(problems, errors.New("MAIL_SMTP_SERVER_NAME must be a valid TLS server name"))
		}
	case "none":
		if settings.Environment != "local" || !loopbackHost(host) {
			problems = append(problems, errors.New("MAIL_SMTP_TLS=none is allowed only for loopback SMTP in local development"))
		}
		if settings.MailSMTPUsername != "" {
			problems = append(problems, errors.New("SMTP authentication requires TLS"))
		}
	default:
		problems = append(problems, errors.New("MAIL_SMTP_TLS must be starttls, implicit, or none"))
	}
	if settings.MailSMTPTimeout <= 0 || settings.MailSMTPTimeout > time.Minute {
		problems = append(problems, errors.New("MAIL_SMTP_TIMEOUT must be positive and no longer than 1m"))
	}
	return errors.Join(problems...)
}

func validServerName(value string) bool {
	return value != "" && strings.TrimSpace(value) == value && !strings.ContainsAny(value, "/:@[]")
}

func loopbackHost(host string) bool {
	if strings.EqualFold(host, "localhost") {
		return true
	}
	address := net.ParseIP(host)
	return address != nil && address.IsLoopback()
}

func decodeOutboxKey(value string) ([]byte, error) {
	decoded, err := base64.RawURLEncoding.DecodeString(value)
	if err != nil || len(decoded) != 32 || base64.RawURLEncoding.EncodeToString(decoded) != value {
		return nil, errors.New("MAIL_OUTBOX_KEY must be exactly 32 random bytes encoded as unpadded base64url")
	}
	return decoded, nil
}

func reader() (*forgeconfig.Reader, error) {
	environment := forgeconfig.FromEnvironment()
	if err := environment.LoadFile(".env"); err != nil {
		return nil, err
	}
	return environment, nil
}
