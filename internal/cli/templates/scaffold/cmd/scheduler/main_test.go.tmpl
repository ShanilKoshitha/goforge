package main

import "testing"

func TestParseMode(t *testing.T) {
	for _, test := range []struct {
		name    string
		args    []string
		once    bool
		wantErr bool
	}{
		{name: "daemon"},
		{name: "once", args: []string{"--once"}, once: true},
		{name: "unknown", args: []string{"--watch"}, wantErr: true},
		{name: "extra", args: []string{"--once", "extra"}, wantErr: true},
	} {
		t.Run(test.name, func(t *testing.T) {
			once, err := parseMode(test.args)
			if (err != nil) != test.wantErr {
				t.Fatalf("parseMode(%q) error = %v", test.args, err)
			}
			if once != test.once {
				t.Fatalf("parseMode(%q) once = %t, want %t", test.args, once, test.once)
			}
		})
	}
}
