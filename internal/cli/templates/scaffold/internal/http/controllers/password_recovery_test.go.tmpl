type fakePasswordRecovery struct {
	requestEmail string
	resetToken   string
	resetSecret  string
	requestErr   error
	resetErr     error
}

func (recovery *fakePasswordRecovery) Request(_ context.Context, email string) error {
	recovery.requestEmail = email
	return recovery.requestErr
}

func (recovery *fakePasswordRecovery) Reset(_ context.Context, token, secret string) error {
	recovery.resetToken = token
	recovery.resetSecret = secret
	return recovery.resetErr
}

type recordingRenderer struct {
	status int
	name   string
	page   controllers.PasswordRecoveryPage
}

func (renderer *recordingRenderer) Render(response http.ResponseWriter, status int, name string, data any) error {
	renderer.status = status
	renderer.name = name
	renderer.page = data.(controllers.PasswordRecoveryPage)
	response.Header().Set("Content-Type", "text/html; charset=utf-8")
	response.WriteHeader(status)
	return nil
}

func TestPasswordRecoveryJSONContracts(t *testing.T) {
	const token = "selector.secret"
	const replacement = "a replacement passphrase"
	recovery := &fakePasswordRecovery{}
	controller := controllers.NewPasswordRecoveryController(recovery, &recordingRenderer{})
	router := httpx.NewRouter()
	router.POST("/auth/password/forgot", controller.ForgotJSON)
	router.POST("/auth/password/reset", controller.ResetJSON)

	forgot := httptest.NewRequest(http.MethodPost, "/auth/password/forgot", strings.NewReader(`{"email":" Ada@Example.COM "}`))
	forgot.Header.Set("Content-Type", "application/json")
	response := httptest.NewRecorder()
	router.ServeHTTP(response, forgot)
	if response.Code != http.StatusAccepted || response.Header().Get("Content-Type") != "application/json; charset=utf-8" {
		t.Fatalf("forgot response: %d type=%q: %s", response.Code, response.Header().Get("Content-Type"), response.Body.String())
	}
	wantBody := `{"message":"` + controllers.PasswordResetRequestedMessage + `"}` + "\n"
	if response.Body.String() != wantBody || recovery.requestEmail != "ada@example.com" {
		t.Fatalf("forgot contract: body=%q email=%q", response.Body.String(), recovery.requestEmail)
	}
	assertRecoveryHeaders(t, response)

	reset := httptest.NewRequest(http.MethodPost, "/auth/password/reset", strings.NewReader(
		`{"token":"`+token+`","password":"`+replacement+`","password_confirmation":"`+replacement+`"}`,
	))
	reset.Header.Set("Content-Type", "application/json")
	response = httptest.NewRecorder()
	router.ServeHTTP(response, reset)
	if response.Code != http.StatusNoContent || response.Body.Len() != 0 {
		t.Fatalf("reset response: %d: %q", response.Code, response.Body.String())
	}
	if recovery.resetToken != token || recovery.resetSecret != replacement {
		t.Fatalf("reset call: token=%q secret=%q", recovery.resetToken, recovery.resetSecret)
	}
	assertRecoveryHeaders(t, response)
}

func TestPasswordRecoveryJSONRejectsEveryInvalidTokenIdentically(t *testing.T) {
	const secret = "a replacement passphrase"
	errorsToTest := []error{
		auth.ErrInvalidPasswordReset,
		fmtWrappedInvalidReset(),
	}
	var wantBody string
	for index, resetErr := range errorsToTest {
		recovery := &fakePasswordRecovery{resetErr: resetErr}
		controller := controllers.NewPasswordRecoveryController(recovery, &recordingRenderer{})
		router := httpx.NewRouter()
		router.POST("/auth/password/reset", controller.ResetJSON)
		request := httptest.NewRequest(http.MethodPost, "/auth/password/reset", strings.NewReader(
			`{"token":"different-presented-token","password":"`+secret+`","password_confirmation":"`+secret+`"}`,
		))
		request.Header.Set("Content-Type", "application/json")
		response := httptest.NewRecorder()
		router.ServeHTTP(response, request)
		if response.Code != http.StatusUnprocessableEntity {
			t.Fatalf("case %d status = %d: %s", index, response.Code, response.Body.String())
		}
		if index == 0 {
			wantBody = response.Body.String()
		}
		if response.Body.String() != wantBody || strings.Contains(response.Body.String(), "different-presented-token") || strings.Contains(response.Body.String(), secret) {
			t.Fatalf("case %d unsafe or unequal body: %q want %q", index, response.Body.String(), wantBody)
		}
		if wantBody != `{"error":{"message":"`+controllers.PasswordResetRejectedMessage+`"}}`+"\n" {
			t.Fatalf("rejection body = %q", wantBody)
		}
		assertRecoveryHeaders(t, response)
	}
}

func TestPasswordRecoveryBrowserForgotUsesGenericFlash(t *testing.T) {
	recovery := &fakePasswordRecovery{}
	renderer := &recordingRenderer{}
	controller := controllers.NewPasswordRecoveryController(recovery, renderer)
	router, manager := passwordRecoveryBrowserRouter(t)
	public := router.Group("", web.Sessions(manager), web.CSRF())
	public.GET("/forgot-password", controller.ForgotForm)
	public.POST("/forgot-password", controller.Forgot)

	form := httptest.NewRecorder()
	router.ServeHTTP(form, httptest.NewRequest(http.MethodGet, "/forgot-password", nil))
	if form.Code != http.StatusOK || renderer.name != "auth/forgot_password" || renderer.page.Form.CSRFToken == "" {
		t.Fatalf("forgot form: %d name=%q page=%+v", form.Code, renderer.name, renderer.page)
	}
	assertRecoveryHeaders(t, form)
	cookie := responseCookie(t, form)
	response := submitRecoveryForm(router, "/forgot-password", url.Values{
		"_token": {renderer.page.Form.CSRFToken}, "email": {" Ada@Example.COM "},
	}, cookie)
	if response.Code != http.StatusSeeOther || response.Header().Get("Location") != "/forgot-password" {
		t.Fatalf("forgot submit: %d location=%q: %s", response.Code, response.Header().Get("Location"), response.Body.String())
	}
	if recovery.requestEmail != "ada@example.com" {
		t.Fatalf("requested email = %q", recovery.requestEmail)
	}
	assertRecoveryHeaders(t, response)

	cookie = responseCookie(t, response)
	notice := httptest.NewRecorder()
	noticeRequest := httptest.NewRequest(http.MethodGet, "/forgot-password", nil)
	noticeRequest.AddCookie(cookie)
	router.ServeHTTP(notice, noticeRequest)
	if notice.Code != http.StatusOK || renderer.page.Notice != controllers.PasswordResetRequestedMessage {
		t.Fatalf("forgot notice: %d page=%+v", notice.Code, renderer.page)
	}
}

func TestPasswordRecoveryBrowserResetIsDisclosureSafeAndFlashesSuccess(t *testing.T) {
	const presented = "selector.secret"
	const replacement = "a replacement passphrase"
	recovery := &fakePasswordRecovery{resetErr: auth.ErrInvalidPasswordReset}
	renderer := &recordingRenderer{}
	controller := controllers.NewPasswordRecoveryController(recovery, renderer)
	router, manager := passwordRecoveryBrowserRouter(t)
	public := router.Group("", web.Sessions(manager), web.CSRF())
	public.GET("/reset-password", controller.ResetForm)
	public.POST("/reset-password", controller.Reset)
	public.GET("/notice", func(ctx *httpx.Context) error {
		current, ok := web.Session(ctx)
		if !ok {
			return errors.New("missing session")
		}
		var notice string
		if _, err := current.Get("notice", &notice); err != nil {
			return err
		}
		return ctx.JSON(http.StatusOK, struct {
			Notice string `json:"notice"`
		}{Notice: notice})
	})

	form := httptest.NewRecorder()
	request := httptest.NewRequest(http.MethodGet, "/reset-password?token="+url.QueryEscape(presented), nil)
	router.ServeHTTP(form, request)
	if form.Code != http.StatusOK || renderer.name != "auth/reset_password" || renderer.page.Token != presented {
		t.Fatalf("reset form: %d name=%q page=%+v", form.Code, renderer.name, renderer.page)
	}
	assertRecoveryHeaders(t, form)
	cookie := responseCookie(t, form)

	rejected := submitRecoveryForm(router, "/reset-password", url.Values{
		"_token": {renderer.page.Form.CSRFToken}, "token": {presented},
		"password": {replacement}, "password_confirmation": {replacement},
	}, cookie)
	if rejected.Code != http.StatusUnprocessableEntity || renderer.page.Error != controllers.PasswordResetRejectedMessage {
		t.Fatalf("rejected reset: %d page=%+v", rejected.Code, renderer.page)
	}
	if renderer.page.Form.ValidationErrors == nil || strings.Contains(renderer.page.Error, presented) || strings.Contains(renderer.page.Error, replacement) {
		t.Fatalf("unsafe rejection page: %+v", renderer.page)
	}
	assertRecoveryHeaders(t, rejected)

	recovery.resetErr = nil
	cookie = responseCookie(t, rejected)
	completed := submitRecoveryForm(router, "/reset-password", url.Values{
		"_token": {renderer.page.Form.CSRFToken}, "token": {presented},
		"password": {replacement}, "password_confirmation": {replacement},
	}, cookie)
	if completed.Code != http.StatusSeeOther || completed.Header().Get("Location") != "/login" {
		t.Fatalf("completed reset: %d location=%q: %s", completed.Code, completed.Header().Get("Location"), completed.Body.String())
	}
	assertRecoveryHeaders(t, completed)
	cookie = responseCookie(t, completed)
	notice := httptest.NewRecorder()
	noticeRequest := httptest.NewRequest(http.MethodGet, "/notice", nil)
	noticeRequest.AddCookie(cookie)
	router.ServeHTTP(notice, noticeRequest)
	if notice.Code != http.StatusOK || notice.Body.String() != `{"notice":"`+controllers.PasswordResetCompletedMessage+`"}`+"\n" {
		t.Fatalf("completion flash: %d: %s", notice.Code, notice.Body.String())
	}
}

func TestResetPasswordViewContextuallyEscapesPresentedToken(t *testing.T) {
	renderer, err := views.New()
	if err != nil {
		t.Fatal(err)
	}
	controller := controllers.NewPasswordRecoveryController(&fakePasswordRecovery{}, renderer)
	router, manager := passwordRecoveryBrowserRouter(t)
	public := router.Group("", web.Sessions(manager), web.CSRF())
	public.GET("/reset-password", controller.ResetForm)
	const attack = `"><script>alert(1)</script>`
	response := httptest.NewRecorder()
	request := httptest.NewRequest(http.MethodGet, "/reset-password?token="+url.QueryEscape(attack), nil)
	router.ServeHTTP(response, request)
	if response.Code != http.StatusOK {
		t.Fatalf("status = %d: %s", response.Code, response.Body.String())
	}
	if strings.Contains(response.Body.String(), attack) || strings.Contains(response.Body.String(), "<script>") || !strings.Contains(response.Body.String(), "&lt;script") {
		t.Fatalf("token was not contextually escaped: %s", response.Body.String())
	}
}

func fmtWrappedInvalidReset() error {
	return errors.Join(errors.New("repository boundary"), auth.ErrInvalidPasswordReset)
}

func passwordRecoveryBrowserRouter(t *testing.T) (*httpx.Router, *session.Manager) {
	t.Helper()
	manager, err := session.NewManager(
		session.NewMemoryStore(), []byte(strings.Repeat("s", 32)),
		session.Cookie{UnsafeAllowHTTP: true}, time.Hour,
	)
	if err != nil {
		t.Fatal(err)
	}
	return httpx.NewRouter(), manager
}

func submitRecoveryForm(router http.Handler, target string, values url.Values, cookie *http.Cookie) *httptest.ResponseRecorder {
	request := httptest.NewRequest(http.MethodPost, target, strings.NewReader(values.Encode()))
	request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	request.AddCookie(cookie)
	response := httptest.NewRecorder()
	router.ServeHTTP(response, request)
	return response
}

func responseCookie(t *testing.T, response *httptest.ResponseRecorder) *http.Cookie {
	t.Helper()
	cookies := response.Result().Cookies()
	if len(cookies) == 0 {
		t.Fatalf("response has no session cookie: %d %s", response.Code, response.Body.String())
	}
	return cookies[len(cookies)-1]
}

func assertRecoveryHeaders(t *testing.T, response *httptest.ResponseRecorder) {
	t.Helper()
	want := map[string]string{
		"Cache-Control": "no-store", "Referrer-Policy": "no-referrer", "X-Robots-Tag": "noindex",
	}
	for name, value := range want {
		if got := response.Header().Get(name); got != value {
			t.Errorf("%s = %q, want %q", name, got, value)
		}
	}
}
