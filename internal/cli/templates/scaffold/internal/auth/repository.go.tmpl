package auth

import (
	"context"
	"errors"
	"fmt"
	"strings"

	"github.com/ShanilKoshitha/goforge/orm"
	"github.com/ShanilKoshitha/goforge/orm/postgres"

	"[[.Module]]/internal/models"
)

var (
	ErrEmailTaken         = errors.New("email already registered")
	ErrUserNotFound       = errors.New("user not found")
	ErrCredentialsChanged = errors.New("credentials changed concurrently")
)

type UserReader interface {
	ByID(ctx context.Context, id int64) (User, error)
}

type UserRepository interface {
	UserReader
	Create(ctx context.Context, name, email, passwordHash string) (User, error)
	ByEmail(ctx context.Context, email string) (User, error)
	RehashPassword(ctx context.Context, id int64, expectedHash, replacementHash string) (User, error)
	ChangePassword(ctx context.Context, id, expectedVersion int64, expectedHash, replacementHash string) (User, error)
	RevokeSessions(ctx context.Context, id int64) (User, error)
}

// PostgresUserRepository keeps the executor visible so callers may bind the
// repository to either *sql.DB or *sql.Tx without a second implementation.
type PostgresUserRepository struct{ Executor orm.Executor }

func NewPostgresUserRepository(executor orm.Executor) *PostgresUserRepository {
	return &PostgresUserRepository{Executor: executor}
}

func (repository *PostgresUserRepository) Create(ctx context.Context, name, email, passwordHash string) (User, error) {
	query := models.NewStore(repository.Executor).Users()
	user, err := query.Create(models.UserCreateInput{
		Name: strings.TrimSpace(name), Email: normalizeEmail(email),
	}, models.UserColumns.PasswordHash.Set(passwordHash)).One(ctx, repository.Executor)
	err = postgres.Classify(err)
	if errors.Is(err, orm.ErrUnique) {
		return User{}, ErrEmailTaken
	}
	return userResult(user, err)
}

func (repository *PostgresUserRepository) ByEmail(ctx context.Context, email string) (User, error) {
	query := models.NewStore(repository.Executor).Users()
	user, err := query.Select().Where(models.UserColumns.Email.Eq(normalizeEmail(email))).First(ctx, repository.Executor)
	return userResult(user, err)
}

func (repository *PostgresUserRepository) ByID(ctx context.Context, id int64) (User, error) {
	query := models.NewStore(repository.Executor).Users()
	user, err := query.Select().Where(models.UserColumns.ID.Eq(id)).First(ctx, repository.Executor)
	return userResult(user, err)
}

// RehashPassword upgrades storage parameters without revoking sessions because
// the user's password has not changed. The observed hash predicate prevents a
// stale login from overwriting a concurrent password change.
func (repository *PostgresUserRepository) RehashPassword(ctx context.Context, id int64, expectedHash, replacementHash string) (User, error) {
	user, err := repository.query().Update(models.UserChanges{},
		models.UserColumns.PasswordHash.Set(replacementHash),
		orm.SetCurrentTime(models.UserColumns.UpdatedAt),
	).Where(
		models.UserColumns.ID.Eq(id),
		models.UserColumns.PasswordHash.Eq(expectedHash),
	).One(ctx, repository.Executor)
	return credentialResult(user, err)
}

// ChangePassword advances the credential generation in the same statement as
// the hash replacement. Both observed values participate in the predicate so
// two requests authenticated against the same credentials cannot both win.
func (repository *PostgresUserRepository) ChangePassword(ctx context.Context, id, expectedVersion int64, expectedHash, replacementHash string) (User, error) {
	user, err := repository.query().Update(models.UserChanges{},
		models.UserColumns.PasswordHash.Set(replacementHash),
		orm.Increment(models.UserColumns.CredentialVersion, int64(1)),
		orm.SetCurrentTime(models.UserColumns.UpdatedAt),
	).Where(
		models.UserColumns.ID.Eq(id),
		models.UserColumns.CredentialVersion.Eq(expectedVersion),
		models.UserColumns.PasswordHash.Eq(expectedHash),
	).One(ctx, repository.Executor)
	return credentialResult(user, err)
}

// RevokeSessions unconditionally advances the generation for the authenticated
// account. Keeping the increment in one statement makes it linearizable with a
// concurrent password change: either that change loses its CAS, or this later
// increment invalidates the change winner too.
func (repository *PostgresUserRepository) RevokeSessions(ctx context.Context, id int64) (User, error) {
	user, err := repository.query().Update(models.UserChanges{},
		orm.Increment(models.UserColumns.CredentialVersion, int64(1)),
		orm.SetCurrentTime(models.UserColumns.UpdatedAt),
	).Where(
		models.UserColumns.ID.Eq(id),
	).One(ctx, repository.Executor)
	return credentialResult(user, err)
}

func (repository *PostgresUserRepository) query() models.UserQuery {
	return models.NewStore(repository.Executor).Users()
}

func userResult(user models.User, err error) (User, error) {
	err = postgres.Classify(err)
	if errors.Is(err, orm.ErrNotFound) {
		return User{}, ErrUserNotFound
	}
	if err != nil {
		return User{}, fmt.Errorf("query user: %w", err)
	}
	return user, nil
}

func credentialResult(user models.User, err error) (User, error) {
	err = postgres.Classify(err)
	if errors.Is(err, orm.ErrNotFound) {
		return User{}, ErrCredentialsChanged
	}
	if err != nil {
		return User{}, fmt.Errorf("update credentials: %w", err)
	}
	return user, nil
}

func normalizeEmail(email string) string { return strings.ToLower(strings.TrimSpace(email)) }
